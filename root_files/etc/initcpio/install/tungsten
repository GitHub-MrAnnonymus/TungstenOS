#!/bin/bash
build() {
    # IPE policy, generated by build.sh (it embeds the /usr verity root hash)
    add_file /etc/ipe_setup/hardened.policy.p7b
    add_systemd_unit tungsten-ipe-policy.service
    add_symlink /etc/systemd/system/sysinit.target.wants/tungsten-ipe-policy.service \
        /usr/lib/systemd/system/tungsten-ipe-policy.service

    # /etc overlay: image defaults below, local changes on the root partition above
    add_module overlay
    add_binary /usr/lib/tungsten/etc-overlay
    add_systemd_unit tungsten-etc-overlay.service
    # Required: booting with the bare /etc of the root partition looks like a first boot
    # (no machine-id, no accounts). A failed mount stops the boot instead, and boot
    # counting falls back to the previous image.
    add_symlink /etc/systemd/system/initrd-fs.target.requires/tungsten-etc-overlay.service \
        /usr/lib/systemd/system/tungsten-etc-overlay.service

    # First boot and factory reset: create the encrypted root partition
    add_binary systemd-repart
    add_binary mkfs.ext4
    add_file /etc/mke2fs.conf
    add_binary /usr/lib/systemd/system-generators/systemd-factory-reset-generator
    add_binary /usr/lib/systemd/systemd-factory-reset
    map add_systemd_unit systemd-repart.service factory-reset.target factory-reset-now.target \
        systemd-factory-reset-complete.service
}

help() {
    echo "TungstenOS: IPE policy, /etc overlay and root partition creation."
}
