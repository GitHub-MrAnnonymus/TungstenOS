// System-wide fastfetch settings (a user's ~/.config/fastfetch/config.jsonc takes
// precedence): the TungstenOS mark, frame grey ($1) and filament orange ($2), keys in
// the filament's colour. A config file replaces fastfetch's defaults, so the modules are
// listed here.
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "file",
    "source": "/usr/share/tungsten/fastfetch-logo.txt",
    "color": { "1": "38;5;247", "2": "38;5;215" },
    "padding": { "top": 1, "right": 3 }
  },
  "display": {
    "color": { "keys": "38;5;215", "title": "38;5;215" }
  },
  "modules": [
    "title", "separator",
    "os", "host", "kernel", "uptime", "packages", "shell",
    "display", "wm", "theme", "icons", "font", "cursor", "terminal",
    "cpu", "gpu", "memory", "swap", "disk", "battery", "locale",
    "break", "colors"
  ]
}
