// System-wide fastfetch settings (a user's ~/.config/fastfetch/config.jsonc takes
// precedence): the TungstenOS mark, frame grey ($1) and filament orange ($2).
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "file",
    "source": "/usr/share/tungsten/fastfetch-logo.txt",
    "color": { "1": "38;5;247", "2": "38;5;215" },
    "padding": { "top": 1, "right": 3 }
  }
}
