[Unit]
ConditionPathExists=/usr/bin/rog-control-center
Description=ROG Control Center
After=graphical-session.target
PartOf=graphical-session.target
# Give up instead of restarting forever when asusd is not running (non-ASUS hardware)
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
# Run through bash: /home is mounted noexec and IPE blocks executing files outside the image.
ExecStart=/bin/bash %h/.config/hypr/rog-control-center.sh
Restart=on-failure
RestartSec=2

[Install]
WantedBy=graphical-session.target
