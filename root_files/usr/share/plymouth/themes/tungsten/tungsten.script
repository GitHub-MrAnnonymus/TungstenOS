# TungstenOS boot splash: the W filament of the logo heats up with boot progress
# (ember, tungsten orange, white) and cools down at shutdown. Layers rendered from
# branding/make-logo.py: frame.png (the cell, dark), cold.png (ember filament),
# hot.png (glowing filament), glow.png (halo), bullet.png (one typed character),
# wordmark-<height>.png ("TungstenOS" in Manrope, several sizes).

# Everything is laid out from the window size, again whenever it changes: Plymouth starts
# on the firmware framebuffer (simpledrm), and when the GPU driver takes over at the
# display's own resolution, a layout made once stayed at the old coordinates (top left).

Window.SetBackgroundTopColor(0, 0, 0);
Window.SetBackgroundBottomColor(0, 0, 0);

frame_image = Image("frame.png");
cold_image = Image("cold.png");
glow_image = Image("glow.png");
hot_image = Image("hot.png");
frame = Sprite();
cold = Sprite();
glow = Sprite();
hot = Sprite();
wordmark = Sprite();

progress = 0;
shown = 0;
ticks = 0;
mode = Plymouth.GetMode();
cooling = (mode != "boot" && mode != "resume");

fun progress_cb(duration, value) {
  global.progress = value;
}
Plymouth.SetBootProgressFunction(progress_cb);

# 50 refreshes per second. Boot: follow progress, smoothed. Shutdown: start hot and cool
# down over about three seconds.
# Function variables are local; the animation state lives in global.
fun refresh_cb() {
  if (Window.GetWidth() != global.layout_w || Window.GetHeight() != global.layout_h)
    layout();
  global.ticks = global.ticks + 1;
  if (global.cooling)
    target = 1 - Math.Min(1, global.ticks / 150);
  else
    target = 0.12 + 0.88 * global.progress;
  global.shown = global.shown + (target - global.shown) * 0.06;
  flicker = 0.025 * Math.Sin(global.ticks * 0.21) + 0.015 * Math.Sin(global.ticks * 0.53);
  heat = Math.Clamp(global.shown + flicker, 0, 1);
  hot.SetOpacity(heat);
  glow.SetOpacity(heat * heat);
  cold.SetOpacity(1 - heat * 0.6);
}
Plymouth.SetRefreshFunction(refresh_cb);

# Passphrase or PIN prompt of the encrypted root partition, below the mark: the prompt
# text, then one glowing dot per typed character (images; the initramfs fonts lack ●).
prompt_sprite = Sprite();
message_sprite = Sprite();
prompt = "";
bullets = 0;
prompt_shown = 0;
message = "";
message_shown = 0;
dot_image = Image("bullet.png");
dot_gap = 24;
dot_max = 48;
for (i = 0; i < dot_max; i++) {
  dots[i] = Sprite(dot_image);
  dots[i].SetOpacity(0);
}

fun center_x(image) {
  return Window.GetX() + Window.GetWidth() / 2 - image.GetWidth() / 2;
}

fun display_password_cb(prompt, bullets) {
  global.prompt = prompt;
  global.bullets = bullets;
  global.prompt_shown = 1;
  p = Image.Text(prompt, 0.72, 0.74, 0.78, 1, "Sans 13");
  global.prompt_sprite.SetImage(p);
  global.prompt_sprite.SetPosition(center_x(p), global.text_y, 10);
  global.prompt_sprite.SetOpacity(1);
  n = Math.Min(bullets, global.dot_max);
  left = Window.GetX() + Window.GetWidth() / 2 - (n * global.dot_gap) / 2;
  for (i = 0; i < global.dot_max; i++) {
    if (i < n) {
      global.dots[i].SetPosition(left + i * global.dot_gap, global.text_y + p.GetHeight() + 16, 10);
      global.dots[i].SetOpacity(1);
    } else {
      global.dots[i].SetOpacity(0);
    }
  }
}
Plymouth.SetDisplayPasswordFunction(display_password_cb);

fun display_normal_cb() {
  global.prompt_shown = 0;
  global.prompt_sprite.SetOpacity(0);
  for (i = 0; i < global.dot_max; i++)
    global.dots[i].SetOpacity(0);
}
Plymouth.SetDisplayNormalFunction(display_normal_cb);

fun message_cb(text) {
  global.message = text;
  global.message_shown = 1;
  m = Image.Text(text, 0.55, 0.57, 0.62, 1, "Sans 11");
  global.message_sprite.SetImage(m);
  global.message_sprite.SetPosition(center_x(m), global.wordmark_y - m.GetHeight() - 24, 10);
}
Plymouth.SetMessageFunction(message_cb);

fun layout() {
  global.layout_w = Window.GetWidth();
  global.layout_h = Window.GetHeight();
  # The mark: 30 % of the shorter side, centred.
  size = Math.Int(Math.Min(global.layout_w, global.layout_h) * 0.30);
  x = Window.GetX() + global.layout_w / 2 - size / 2;
  y = Window.GetY() + global.layout_h / 2 - size / 2;
  global.frame.SetImage(global.frame_image.Scale(size, size));
  global.frame.SetPosition(x, y, 1);
  global.cold.SetImage(global.cold_image.Scale(size, size));
  global.cold.SetPosition(x, y, 2);
  global.glow.SetImage(global.glow_image.Scale(size, size));
  global.glow.SetPosition(x, y, 3);
  global.hot.SetImage(global.hot_image.Scale(size, size));
  global.hot.SetPosition(x, y, 4);
  global.text_y = y + size + 28;

  # The wordmark, bottom centre, about 4 % of the screen height: the largest pre-rendered
  # size that fits (shown pixel for pixel; Plymouth's scaling makes thin text jagged).
  target = global.layout_h * 0.042;
  h = 24;
  if (target >= 32) h = 32;
  if (target >= 40) h = 40;
  if (target >= 48) h = 48;
  if (target >= 56) h = 56;
  if (target >= 64) h = 64;
  if (target >= 72) h = 72;
  if (target >= 88) h = 88;
  if (h == 24) image = Image("wordmark-24.png");
  if (h == 32) image = Image("wordmark-32.png");
  if (h == 40) image = Image("wordmark-40.png");
  if (h == 48) image = Image("wordmark-48.png");
  if (h == 56) image = Image("wordmark-56.png");
  if (h == 64) image = Image("wordmark-64.png");
  if (h == 72) image = Image("wordmark-72.png");
  if (h == 88) image = Image("wordmark-88.png");
  global.wordmark.SetImage(image);
  global.wordmark_y = Window.GetY() + global.layout_h - h - Math.Int(global.layout_h * 0.07);
  global.wordmark.SetPosition(Window.GetX() + global.layout_w / 2 - image.GetWidth() / 2, global.wordmark_y, 5);

  # What was on screen, at the new place.
  if (global.prompt_shown)
    display_password_cb(global.prompt, global.bullets);
  if (global.message_shown)
    message_cb(global.message);
}
layout();
