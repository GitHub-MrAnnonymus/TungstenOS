// The active local session may start, without a password, Tungsten Guard's
//   refresh button: the update check (tungsten-guard-check.service), which only reads
//     (TungstenOS, Flatpak and firmware updates) and writes /run/tungsten-guard/status.json;
//   Flatpak "Update" button: the daily Flatpak update (tungsten-flatpak-update.service)
//     now, which installs only updates of the system-wide apps and runtimes from their remotes.
polkit.addRule(function(action, subject) {
    if (action.id == "org.freedesktop.systemd1.manage-units" &&
        ["tungsten-guard-check.service", "tungsten-flatpak-update.service"]
            .indexOf(action.lookup("unit")) >= 0 &&
        action.lookup("verb") == "start" &&
        subject.local && subject.active) {
        return polkit.Result.YES;
    }
});
