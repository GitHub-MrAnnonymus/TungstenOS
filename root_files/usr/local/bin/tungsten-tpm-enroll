#!/bin/bash
# Binds the root partition's TPM2 key to a systemd-pcrlock policy.
# Run after installation and after a factory reset.
# Usage: run0 tungsten-tpm-enroll [--pin|--no-pin]
set -euo pipefail
[ "$EUID" -eq 0 ] || { echo "run with run0" >&2; exit 1; }
PCRLOCK=/usr/lib/systemd/systemd-pcrlock
POLICY=/var/lib/systemd/pcrlock.json
DEV=/dev/disk/by-partlabel/root
case "${1:-}" in
  --pin) pin=yes ;;
  --no-pin) pin=no ;;
  "")
    echo "Require a PIN at boot to unlock the system?"
    echo "  yes: the TPM releases the key only with your PIN, even on an untampered boot"
    echo "  no:  the TPM releases the key on an untampered boot; homes stay locked"
    echo "       until each user logs in"
    read -r -p "Use a PIN? [Y/n] " a
    if [ "${a,,}" = n ]; then pin=no; else pin=yes; fi
    ;;
  *) echo "usage: $0 [--pin|--no-pin]" >&2; exit 2 ;;
esac

# PIN brute-force protection: the TPM allows 32 wrong PINs, then one more every two
# hours. The lockout authorization is set to a random value that is never stored, so
# nothing (including another OS booted on this machine) can reset that counter. A TPM
# clear from the firmware setup still works and only costs the TPM unlock.
if tpm2_getcap properties-variable | grep -q 'lockoutAuthSet: *0'; then
  tpm2_dictionarylockout --setup-parameters --max-tries=32 --recovery-time=7200 \
    --lockout-recovery-time=86400
  tpm2_changeauth -c lockout "file:-" < <(head -c 32 /dev/urandom | base64 -w0)
fi

for u in firmware-code firmware-config secureboot-policy secureboot-authority; do
  systemctl start "systemd-pcrlock-$u.service"
done
/usr/local/lib/tungsten/pcrlock-predict

# pcrlock's default range (--location=760-:940-) covers PCR 11 from the initrd to the
# running system, so the running system can update the policy before rebooting into an
# update (systemd-sysupdate-notify-pcrlock@.service). The key itself stays initrd-only:
# it also needs the signed PCR 11 policy below (policyref "initrd").
if [ -e "$POLICY" ]; then
  # Updating the policy needs a boot matching its prediction; otherwise use the
  # recovery PIN shown at the first enrollment. --force: make-policy compares the new
  # prediction only with pcrlock.json and skips the TPM write if they are identical, but
  # pcrlock.json can be ahead of the TPM's NV index after a failed write.
  "$PCRLOCK" make-policy --force --policy="$POLICY" \
    || "$PCRLOCK" make-policy --force --policy="$POLICY" --recovery-pin=query
else
  echo ">>> Creating the pcrlock policy. Store the recovery PIN shown below; it is"
  echo ">>> needed to update the policy if the TPM state ever stops matching."
  "$PCRLOCK" make-policy --policy="$POLICY" --recovery-pin=show
fi
"$PCRLOCK" predict

meta=$(cryptsetup luksDump --dump-json-metadata "$DEV")
non_tpm=$(jq '[.tokens[] | select(.type == "systemd-tpm2") | .keyslots[]] as $tpm
  | [.keyslots | keys[] | select(. as $k | $tpm | index($k) | not)] | length' <<<"$meta")
# The key this script enrolls only unlocks in the initrd (policyref "initrd" below), so
# systemd-cryptenroll asks for the passphrase or recovery key. A partition recreated by a
# factory reset has only repart's TPM key, whose signed PCR 11 policy holds in every boot
# phase: it authorizes a recovery key here, if the first-boot wizard did not add a
# passphrase.
if [ "$non_tpm" -eq 0 ]; then
  echo ">>> Adding a recovery key. Store it safely; it unlocks the system without the TPM."
  systemd-cryptenroll --unlock-tpm2-device=auto --recovery-key "$DEV"
fi

# Signed PCR 11 policy (any UKI signed by the build, initrd phase only) plus pcrlock
# (firmware, Secure Boot, bootloader).
systemd-cryptenroll --wipe-slot=tpm2 --tpm2-device=auto \
  --tpm2-public-key=/etc/systemd/tpm2-pcr-public-key.pem --tpm2-public-key-policyref=initrd \
  --tpm2-pcrlock="$POLICY" --tpm2-with-pin="$pin" "$DEV"
echo "Enrolled."
