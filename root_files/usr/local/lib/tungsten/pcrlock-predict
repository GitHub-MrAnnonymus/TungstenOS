#!/bin/bash
# Predicts PCR 4/11 for the installed bootloader and both A/B UKIs.
# --make-policy also refreshes the TPM policy, if one exists.
set -euo pipefail
PCRLOCK=/usr/lib/systemd/systemd-pcrlock
POLICY=/var/lib/systemd/pcrlock.json
D=/var/lib/pcrlock.d
ESP=$(bootctl --print-esp-path)

mkdir -p "$D"/610-boot-loader-code.pcrlock.d "$D"/650-uki.pcrlock.d "$D"/660-uki.pcrlock.d
rm -f "$D"/610-boot-loader-code.pcrlock.d/*.pcrlock "$D"/650-uki.pcrlock.d/*.pcrlock "$D"/660-uki.pcrlock.d/*.pcrlock
rm -rf "$D"/655-addon-*.pcrlock.d "$D"/655-addon-*.pcrlock

# A TPM policy allows at most 8 alternatives per PCR, so identical copies of the boot
# loader are predicted once.
n=0; seen=" "
for loader in "$ESP"/EFI/systemd/systemd-bootx64.efi "$ESP"/EFI/BOOT/BOOTX64.EFI \
              /usr/lib/systemd/boot/efi/systemd-bootx64.efi.signed; do
  [ -f "$loader" ] || continue
  sum=$(sha256sum "$loader" | cut -d' ' -f1)
  case $seen in *" $sum "*) continue ;; esac
  seen="$seen$sum "
  "$PCRLOCK" lock-pe "$loader" --pcrlock="$D/610-boot-loader-code.pcrlock.d/loader-$((n++)).pcrlock"
done

shopt -s nullglob
ukis=("$ESP"/EFI/Linux/tungsten*.efi)
[ ${#ukis[@]} -gt 0 ] || { echo "no TungstenOS UKIs in $ESP/EFI/Linux" >&2; exit 1; }
for uki in "${ukis[@]}"; do
  name=$(basename "$uki" .efi); name=${name%%+*}   # drop the boot-counting suffix
  "$PCRLOCK" lock-pe  "$uki" --pcrlock="$D/650-uki.pcrlock.d/$name.pcrlock"
  "$PCRLOCK" lock-uki "$uki" --pcrlock="$D/660-uki.pcrlock.d/$name.pcrlock"
done

# UKI add-ons (PCR 4): systemd-stub loads the global ones (loader/addons) with every
# UKI, in name order, then the UKI's own .extra.d ones. Global add-ons are required
# components. A UKI's own add-ons are optional (an empty variant always matches),
# because the other A/B UKI boots without them; making the global ones optional too
# would double the alternatives for PCR 4 past the limit of 8.
# pcrlock assigns a log record only to the first matching variant in name order, and
# not at all once the empty variant came first: "present" must sort before "absent".
n=0
for addon in "$ESP"/loader/addons/*.addon.efi; do
  "$PCRLOCK" lock-pe "$addon" \
    --pcrlock="$D/655-addon-$(printf %02d $((n++)))-$(basename "$addon" .addon.efi).pcrlock"
done
for addon in "$ESP"/EFI/Linux/tungsten*.efi.extra.d/*.addon.efi; do
  c="$D/655-addon-$(printf %02d $((n++)))-$(basename "$addon" .addon.efi).pcrlock.d"
  mkdir -p "$c"
  "$PCRLOCK" lock-pe "$addon" --pcrlock="$c/1-present.pcrlock"
  echo '{"records":[]}' > "$c/2-absent.pcrlock"
done

if [ "${1:-}" = --make-policy ] && [ -e "$POLICY" ]; then
  "$PCRLOCK" make-policy --policy="$POLICY" --location=770
fi
