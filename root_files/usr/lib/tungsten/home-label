#!/bin/sh
# Called by pam_exec at login. systemd-homed creates a home's file system without
# SELinux labels, so everything in it would be unlabeled_t; label it once. Files created
# before that (or while SELinux was permissive) can carry the home directory's own type
# instead of their own; those are relabeled too.
home=$(getent passwd "$PAM_USER" | cut -d: -f6)
[ -n "$home" ] && [ -d "$home" ] || exit 0
case "$(stat -c %C "$home" 2>/dev/null)" in
  *:unlabeled_t|*:unlabeled_t:*) restorecon -RF "$home"; exit 0 ;;
esac
if [ -n "$(find "$home" -xdev -mindepth 1 -maxdepth 4 \( -context '*:unlabeled_t*' \
             -o -context '*:user_home_dir_t*' \) -print -quit 2>/dev/null)" ]; then
  restorecon -RF "$home"
fi
exit 0
