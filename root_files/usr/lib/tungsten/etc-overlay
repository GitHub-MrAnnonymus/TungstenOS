#!/bin/sh
# Mounts /sysroot/etc as an overlay: image defaults (lower) and local changes (upper).
set -eu
ROOT=/sysroot
STATE=$ROOT/var/lib/tungsten/etc
LOWER=$ROOT/usr/share/factory/etc

mkdir -p "$STATE/upper" "$STATE/work" "$ROOT/etc"
# journald keeps the journal on disk only if /var/log/journal exists when it starts; on
# a new root partition it may not create it (its domain may not write to unlabeled /var),
# and the journal of the whole first boot would stay in memory. Owner, mode and ACLs
# follow from tmpfiles.
if [ ! -d "$ROOT/var/log/journal" ]; then
    mkdir -p "$ROOT/var/log/journal"
    getfattr -h -n security.selinux "$ROOT/var" >/dev/null 2>&1 ||
        setfattr -h -n security.selinux -v system_u:object_r:var_t "$ROOT/var"
    setfattr -h -n security.selinux -v system_u:object_r:var_log_t "$ROOT/var/log"
    setfattr -h -n security.selinux -v system_u:object_r:systemd_journal_t "$ROOT/var/log/journal"
fi
# /etc/fstab bind-mounts /var/lib/flatpak onto itself to lift /var's noexec for Flatpak's
# sandboxed programs; the bind mount needs the directory, which Flatpak itself only
# creates at the first installation. Without it, every Flatpak fails until the next boot.
if [ ! -d "$ROOT/var/lib/flatpak" ]; then
    mkdir -p "$ROOT/var/lib/flatpak"
    setfattr -h -n security.selinux -v system_u:object_r:flatpak_content_t "$ROOT/var/lib/flatpak"
fi
# The overlay's top directory (/etc) takes the upper directory's label; on a new root
# partition that is still unlabeled when the first services read /etc.
if ! getfattr -h -n security.selinux "$STATE/upper" >/dev/null 2>&1; then
    setfattr -h -n security.selinux -v system_u:object_r:etc_t "$STATE/upper"
fi

# A new root partition (first boot, factory reset) has no /bin, /lib64, ... links into
# /usr yet; tmpfiles creates them, but only after PID 1 has run the generators, which
# then cannot find the program loader (exit status 127): no fstab mounts, no serial
# getty. Create them from the same list before switching root.
while read -r type path _ _ _ _ target; do
    [ "$type" = L ] || continue
    case "$path" in /*/*|*..*) continue ;; esac
    [ -e "$ROOT$path" ] || [ -L "$ROOT$path" ] || ln -s "$target" "$ROOT$path"
done < "$ROOT/usr/lib/tmpfiles.d/tungsten-factory.conf"

# The new partition's top directory and these links are unlabeled until
# tungsten-relabel.service runs, but the generators and the first services already pass
# through them (ld.so: "libsystemd-shared...: Permission denied"). Label them now: no
# policy is loaded in the initrd, so the kernel stores the labels as given, and the policy
# picks them up when PID 1 loads it.
if ! getfattr -h -n security.selinux "$ROOT" >/dev/null 2>&1; then
    setfattr -h -n security.selinux -v system_u:object_r:root_t "$ROOT"
    for l in bin sbin; do
        [ -L "$ROOT/$l" ] && setfattr -h -n security.selinux -v system_u:object_r:bin_t "$ROOT/$l"
    done
    for l in lib lib64; do
        [ -L "$ROOT/$l" ] && setfattr -h -n security.selinux -v system_u:object_r:lib_t "$ROOT/$l"
    done
fi

# Resets requested by `tungsten-etc reset`, applied before the overlay is mounted.
if [ -f "$STATE/reset" ]; then
    while IFS= read -r path; do
        case "$path" in
            '*') find "$STATE/upper" -mindepth 1 -delete ;;
            ''|/*|*..*) ;;
            *) rm -rf "$STATE/upper/$path" ;;
        esac
    done < "$STATE/reset"
    rm -f "$STATE/reset"
    find "$STATE/work" -mindepth 1 -delete
fi

# Image updates replace the lower layer while the overlay is unmounted. The kernel allows
# that only without index, redirect_dir, metacopy and xino (Documentation/filesystems/
# overlayfs.rst, "Changes to underlying filesystems"); Arch's kernel enables them by default.
mount -t overlay overlay \
    -o "lowerdir=$LOWER,upperdir=$STATE/upper,workdir=$STATE/work" \
    -o index=off,redirect_dir=off,metacopy=off,xino=off,nosuid,nodev,noexec "$ROOT/etc"
