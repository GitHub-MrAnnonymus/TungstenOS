#!/bin/bash
# Locks the empty external USB ports at the controller: a device plugged into a locked port
# is not powered up for enumeration, so nothing of it reaches the kernel's USB code (unlike
# USBGuard, which authorizes devices after the kernel has read their descriptors).
# External ports are those the firmware marks as hotplug (ACPI _PLD, connect_type); internal
# ones (webcam, Bluetooth, fingerprint reader) and ports with a device stay as they are.
# Root can unlock them again: the firmware's own USB setting, with a BIOS password, is the
# protection against a compromised system.
#
#   usb-lock lock      lock the empty external ports (tungsten-usb-lock.service start)
#   usb-lock unlock    unlock them (service stop)
#   usb-lock relock    after a device was unplugged, lock its port if locked (udev)
#   usb-lock initrd    lock right after udev found the USB controllers, before the disk
#                      passphrase (tungsten-usb-lock-initrd.service), on laptops: the
#                      encrypted /etc with the setting is not readable yet. /run, and with it
#                      the lock state, carries over into the system.
#   usb-lock boot      in the system (tungsten-usb-lock-boot.service): lock until the first
#                      login, on laptops by default; /etc/tungsten/usb-lock-at-boot (yes/no)
#                      decides otherwise, and "no" also lifts the initrd lock. On a desktop,
#                      a USB keyboard plugged in only after booting could not type at the
#                      login screen.
#   usb-lock status    write the state for Tungsten Guard
set -uo pipefail
RUN=/run/tungsten-usb-lock
STATUS=/run/tungsten-guard/usb.json

ports() { ls -d /sys/bus/usb/devices/usb*/*-0:1.0/usb*-port* 2>/dev/null; }
# Notebook, laptop, sub-notebook, convertible, detachable (SMBIOS chassis types).
laptop() { case $(cat /sys/class/dmi/id/chassis_type 2>/dev/null) in 8|9|10|14|31|32) return 0 ;; esac; return 1; }
external() { [ "$(cat "$1/connect_type" 2>/dev/null)" = hotplug ]; }
occupied() { [ -e "$1/device" ]; }

status() {
  local p n_ext=0 n_locked=0 locked=false
  for p in $(ports); do
    external "$p" || continue
    n_ext=$((n_ext + 1))
    [ "$(cat "$p/disable" 2>/dev/null)" = 1 ] && n_locked=$((n_locked + 1))
  done
  [ -e "$RUN/locked" ] && locked=true
  mkdir -p "$(dirname "$STATUS")"
  local atboot=false; [ -e "$RUN/boot" ] && atboot=true
  printf '{"locked": %s, "boot": %s, "external": %d, "disabled": %d}\n' "$locked" "$atboot" "$n_ext" "$n_locked" > "$STATUS.new"
  chmod 0644 "$STATUS.new" && mv -f "$STATUS.new" "$STATUS"
}

lock_empty() {
  local p
  for p in $(ports); do
    external "$p" && ! occupied "$p" || continue
    echo 1 > "$p/disable" 2>/dev/null && echo "locked ${p##*/}"
  done
}

case "${1:-}" in
  lock)
    mkdir -p "$RUN" && touch "$RUN/locked"
    lock_empty ;;
  unlock)
    rm -f "$RUN/locked" "$RUN/boot"
    for p in $(ports); do
      external "$p" && [ "$(cat "$p/disable" 2>/dev/null)" = 1 ] && echo 0 > "$p/disable" && echo "unlocked ${p##*/}"
    done ;;
  relock)
    [ -e "$RUN/locked" ] && lock_empty ;;
  initrd)
    laptop || exit 0
    # udev loads the xHCI drivers a moment after the controllers appear.
    for _ in $(seq 30); do [ -n "$(ports)" ] && break; sleep 0.1; done
    mkdir -p "$RUN" && touch "$RUN/locked" "$RUN/boot"
    lock_empty ;;
  boot)
    want=$(cat /etc/tungsten/usb-lock-at-boot 2>/dev/null)
    if [ -z "$want" ]; then laptop && want=yes || want=no; fi
    if [ "$want" = yes ]; then
      mkdir -p "$RUN" && touch "$RUN/boot"
      # The service is the lock's state for the session (stop = unlock); it locks again
      # what the initrd locked, and ports that appeared since.
      systemctl start --no-block tungsten-usb-lock.service
      exit 0
    elif [ -e "$RUN/locked" ]; then
      exec "$0" unlock   # locked by the initrd, but not wanted here
    fi ;;
  status) ;;
  *) echo "usage: usb-lock lock|unlock|relock|status" >&2; exit 2 ;;
esac
status
