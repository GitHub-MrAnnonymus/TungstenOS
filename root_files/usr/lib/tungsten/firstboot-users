#!/bin/bash
# First boot (systemd-homed-firstboot.service): creates two systemd-homed accounts.
#  - an administrator (wheel): only authorizes run0 and polkit prompts with its own
#    password, may log in on a console but not at the login screen;
#  - the everyday account (not wheel), used for the desktop.
# Someone who learns the everyday password still cannot become root.
# homed's own rate limit is stored in the account record, so unlike pam_faillock's
# counters it survives reboots: at most 10 password checks per 5 minutes, 30 for the
# administrator (every run0 or polkit prompt checks its password about twice).
set -euo pipefail
LIMITS=(--rate-limit-interval=300 --rate-limit-burst=10)
ADMIN_LIMITS=(--rate-limit-interval=300 --rate-limit-burst=30)

if homectl list --no-legend 2>/dev/null | grep -q .; then
  exit 0   # accounts exist already (or were provisioned via credentials)
fi

# Plymouth owns the console until the login screen starts and would swallow the prompts
# and the typed answers; PID 1's status messages would scroll over them.
plymouth quit 2>/dev/null || :
kill -s RTMIN+21 1 2>/dev/null || :          # status messages off
# The wizard runs on tty2 (TTYPath in the unit's drop-in): show it, and return to tty1,
# the login screen's console, at the end.
chvt 2 2>/dev/null || :
trap 'kill -s RTMIN+20 1 2>/dev/null || :; chvt 1 2>/dev/null || :' EXIT
clear 2>/dev/null || :

# homed binds each account to the machine ID. On the first boot that ID is still the
# transient one, saved only later by systemd-machine-id-commit; accounts bound to an ID
# that is never saved are "unfixated" from the next boot on, and their passwords no
# longer work for run0 or console logins. Save it now, and create nothing otherwise.
# Its output is kept in /var/lib/tungsten/firstboot.log: the first boot's journal may
# not reach the disk.
if mountpoint -q /etc/machine-id; then
  { date; findmnt /etc/machine-id; systemd-machine-id-setup --commit; echo "exit $?"; } \
    </dev/null >>/var/lib/tungsten/firstboot.log 2>&1 || :
fi
if mountpoint -q /etc/machine-id || ! systemd-id128 machine-id >/dev/null; then
  echo "The machine ID could not be saved; no accounts were created." >&2
  echo "See: journalctl -m -b -u systemd-homed-firstboot -u systemd-machine-id-commit" >&2
  read -r -t 300 -p "Press Enter to continue. " _ || :
  exit 1
fi

# --- Wizard (gum) ---
# gum needs a terminal; without one each prompt fails at once and its retry loop would spin
# forever, holding up the login screen. Fail instead: the next boot asks again.
if ! [ -t 0 ] || ! [ -t 1 ]; then
  { date; echo "No terminal on stdin/stdout ($(readlink /proc/self/fd/0), $(readlink /proc/self/fd/1)); no accounts created."; } \
    >>/var/lib/tungsten/firstboot.log 2>&1
  exit 1
fi
ACCENT=212 MUTED=245 WARN=203 OK=78
export GUM_CHOOSE_CURSOR_FOREGROUND=$ACCENT GUM_INPUT_CURSOR_FOREGROUND=$ACCENT \
  GUM_INPUT_PROMPT_FOREGROUND=$ACCENT GUM_SPIN_SPINNER_FOREGROUND=$ACCENT \
  GUM_FILTER_INDICATOR_FOREGROUND=$ACCENT GUM_FILTER_MATCH_FOREGROUND=$ACCENT \
  GUM_CONFIRM_SELECTED_BACKGROUND=$ACCENT
LOG=/run/tungsten-firstboot.log
STEPS=4
# After a factory reset the new root partition has only its TPM key (systemd-repart): ask for
# a recovery passphrase, as the installer does. A slot no systemd-tpm2 token uses is a
# passphrase or recovery key.
ROOTDEV=/dev/disk/by-partlabel/root
need_recovery=0
if meta=$(cryptsetup luksDump --dump-json-metadata "$ROOTDEV" 2>/dev/null) &&
   [ "$(jq '[.tokens[] | select(.type == "systemd-tpm2") | .keyslots[]] as $tpm
        | [.keyslots | keys[] | select(. as $k | $tpm | index($k) | not)] | length' <<<"$meta")" -eq 0 ]; then
  need_recovery=1
  STEPS=5
fi
step=1

header() {
  clear
  gum style --border rounded --border-foreground "$ACCENT" --padding "1 4" --margin "1 2" \
    --align center --width 64 \
    "$(gum style --bold --foreground "$ACCENT" 'W E L C O M E   T O   T U N G S T E N')" \
    "$(gum style --foreground "$MUTED" "$1")"
}
say()  { gum style --margin "0 2" --width 68 "$@"; }
warn() { gum style --margin "0 2" --width 68 --foreground "$WARN" "$@"; }

ask_name() {   # prompt placeholder [default]
  local name
  while :; do
    name=$(gum input --prompt "$1 › " --placeholder "$2" --value "${3:-}" --width 60) || continue
    if [[ $name =~ ^[a-z_][a-z0-9_-]{0,30}$ ]] && ! getent passwd "$name" >/dev/null; then
      echo "$name"; return
    fi
    warn "Lowercase letters, digits, - and _, starting with a letter; not a name in use." >&2
  done
}
ask_password() {   # who
  local p1 p2
  while :; do
    p1=$(gum input --password --prompt "Password › " --placeholder "$1's password" --width 60) || continue
    p2=$(gum input --password --prompt "Repeat › " --placeholder "the same password again" --width 60) || continue
    if [ -z "$p1" ]; then warn "The password must not be empty." >&2
    elif [ "$p1" != "$p2" ]; then warn "The passwords do not match." >&2
    else printf '%s' "$p1"; return; fi
  done
}
# Creates a home with NEWPASSWORD; prints homed's reason and returns 1 if it refuses.
create_home() {   # title password homectl-args...
  local title=$1 pw=$2; shift 2
  : > "$LOG"
  if NEWPASSWORD=$pw gum spin --title "$title" -- bash -c 'l=$1; shift; "$@" >>"$l" 2>&1' _ "$LOG" homectl create "$@"; then
    return 0
  fi
  warn "$(tail -n 3 "$LOG")" >&2
  return 1
}

# 1. Time zone and computer name (written to /etc by systemd-firstboot, no services needed)
header "Step $step of $STEPS · Time zone"
say "Type to search, Enter to choose."
echo
# From tzdata directly: timedatectl asks timedated, which may not run this early.
zones() { awk '$1 == "Z" {print $2} $1 == "L" {print $3}' /usr/share/zoneinfo/tzdata.zi | sort -u; }
tz=$(zones | gum filter --height 12 --placeholder "e.g. Europe/Belgrade" --value "") || tz=UTC
header "Step $step of $STEPS · Computer name"
say "The name this computer uses on networks."
echo
host=""
until [[ $host =~ ^[a-zA-Z0-9]([a-zA-Z0-9-]{0,61}[a-zA-Z0-9])?$ ]]; do
  host=$(gum input --prompt "Name › " --value "tungsten" --width 60) || host=tungsten
done
systemd-firstboot --force --timezone="$tz" --hostname="$host" >/dev/null 2>&1 \
  || warn "Could not set the time zone or name; change them later with timedatectl and hostnamectl."
hostname "$host" 2>/dev/null || :

# 2. Recovery passphrase, after a factory reset only. The repart-made TPM key unlocks from
# the running system too (signed PCR 11 policy for every boot phase, no policyref), so it
# authorizes adding the passphrase.
if [ "$need_recovery" = 1 ]; then
  step=$((step + 1))
  header "Step $step of $STEPS · Recovery passphrase"
  say "This computer was reset, and its disk got a new key that only this computer's TPM" \
      "holds. The recovery passphrase unlocks the disk without the TPM, for example after" \
      "a firmware change." "" "$(gum style --bold 'Store it safely: without it and the TPM, the data is lost.')"
  echo
  while :; do
    p1=$(gum input --password --placeholder "Recovery passphrase (12+ characters)" --width 60) || continue
    p2=$(gum input --password --placeholder "Repeat the passphrase" --width 60) || continue
    if [ "$p1" != "$p2" ]; then warn "The passphrases do not match." >&2; continue
    elif [ ${#p1} -lt 12 ]; then warn "Use at least 12 characters." >&2; continue; fi
    : > "$LOG"
    if NEWPASSWORD=$p1 gum spin --title "Adding the recovery passphrase…" -- \
         bash -c 'systemd-cryptenroll --unlock-tpm2-device=auto --password "$1" >>"$2" 2>&1' _ "$ROOTDEV" "$LOG"; then
      break
    fi
    warn "Could not add it: $(tail -n 2 "$LOG")" "Add one later with: run0 tungsten-tpm-enroll" >&2
    break
  done
  unset p1 p2
fi

# 3. Administrator
step=$((step + 1))
header "Step $step of $STEPS · Administrator"
say "The administrator only authorizes: its password is asked when you run run0 or a" \
    "settings dialog needs permission. It cannot log in at the login screen, so someone" \
    "who learns your everyday password still cannot change the system." "" \
    "$(gum style --bold 'Use a different password than for your everyday account.')"
echo
admin=$(ask_name "Name" "admin" admin)
while :; do
  admin_pw=$(ask_password "$admin")
  # The administrator's home holds nothing, but polkit and run0 mount it to check the
  # password; homed's default size (a share of all free space) would fill the disk.
  create_home "Creating $admin…" "$admin_pw" "$admin" --real-name=Administrator \
    --storage=luks --member-of=wheel --noexec=yes --disk-size=2G --rebalance-weight=off \
    "${ADMIN_LIMITS[@]}" && break
done

# 4. Everyday account
step=$((step + 1))
header "Step $step of $STEPS · Your account"
say "The account you use every day. Its home is encrypted with your password and locked" \
    "whenever you log out."
echo
full=$(gum input --prompt "Full name › " --placeholder "shown at the login screen" --width 60) || full=
suggest=$(printf '%s' "${full%% *}" | tr '[:upper:]' '[:lower:]' | tr -cd 'a-z0-9_-')
user=$(ask_name "User name" "lowercase, e.g. ${suggest:-alex}" "$suggest")
while :; do
  user_pw=$(ask_password "$user")
  if [ "$user_pw" = "$admin_pw" ]; then
    warn "That is the administrator's password; choose a different one." >&2; continue
  fi
  args=(); [ -n "$full" ] && args+=(--real-name="$full")
  create_home "Creating $user…" "$user_pw" "$user" "${args[@]}" \
    --storage=luks --noexec=yes "${LIMITS[@]}" && break
done
unset admin_pw user_pw

# 5. Done
step=$((step + 1))
header "Step $step of $STEPS · Ready"
gum style --margin "0 2" --foreground "$OK" --bold "All set. Log in as $user at the login screen."
echo
say "Next, bind the disk to this computer's TPM so it unlocks without the recovery" \
    "passphrase (it asks for the administrator's password):" "" \
    "$(gum style --foreground "$ACCENT" '    run0 tungsten-tpm-enroll')"
echo
gum spin --spinner dot --title "Starting the login screen…" -- sleep 3
