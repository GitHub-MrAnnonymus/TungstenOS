#!/bin/bash
# Checks for updates (TungstenOS, Flatpaks, firmware including the Secure Boot dbx) and the
# hardware security state (Secure Boot, TPM, disk unlock, verified /usr, fwupd's HSI), and
# writes the result to /run/tungsten-guard/status.json, which the Dux Shell widget reads.
# tungsten-guard-check.service runs it at boot and hourly (tungsten-guard-check.timer).
set -uo pipefail
DIR=/run/tungsten-guard
OUT=$DIR/status.json

# TungstenOS: a newer release on the update server (systemd-sysupdate checks the signed
# SHA256SUMS; it downloads nothing else). Prints the new version, exits 0 if there is one.
os_new=null
if v=$(/usr/lib/systemd/systemd-sysupdate check-new 2>/dev/null); then
  v=$(printf '%s\n' "$v" | grep -oE '[0-9]{12}' | tail -1)
  [ -n "$v" ] && os_new=$(jq -Rn --arg v "$v" '$v')
fi
os_cur=$(. /usr/lib/os-release; echo "${IMAGE_VERSION:-${VERSION_ID:-}}")
channel=$(cat /etc/tungsten/channel 2>/dev/null || echo stable)   # tungsten-channel

# Flatpak apps and runtimes with updates (tungsten-flatpak-update.timer installs them).
flatpaks=$(flatpak remote-ls --system --updates --columns=application 2>/dev/null | grep -c . || :)

# Firmware from the LVFS, through fwupd: device firmware and the UEFI revocation list (dbx),
# which only applies where Microsoft's KEK is enrolled (enroll-secureboot.sh --trust=microsoft).
fw='[]'
if j=$(fwupdmgr get-updates --json --no-unreported-check --no-metadata-check 2>/dev/null); then
  fw=$(jq -c '[.Devices[]? | select((.Releases // []) | length > 0)
      | {name: .Name, version: .Version, new: .Releases[0].Version,
         dbx: ((.Plugin // "") == "uefi_dbx" or ((.Name // "") | test("dbx"; "i")))}]' <<<"$j" 2>/dev/null) || fw='[]'
fi

# --- Hardware security ---
# Secure Boot: "enabled (user)" when the firmware enforces it; "setup" means no keys.
sb=$(bootctl status 2>/dev/null | sed -n 's/^ *Secure Boot: *//p' | head -1)
# TPM 2.0, and whether its PIN lockout can be reset (tungsten-tpm-enroll sets it).
tpm=null; lockout=false
if [ -e /dev/tpmrm0 ]; then
  tpm=$(cat /sys/class/tpm/tpm0/tpm_version_major 2>/dev/null || echo 2)
  tpm2_getcap properties-variable 2>/dev/null | grep -q 'lockoutAuthSet: *1' && lockout=true
fi
# Disk unlock, as tungsten-audit sees it: bound with pcrlock (with or without PIN), a
# passphrase only, or repart's TPM key without pcrlock (any TungstenOS boot unlocks it).
disk=unknown
if meta=$(cryptsetup luksDump --dump-json-metadata /dev/disk/by-partlabel/root 2>/dev/null); then
  disk=$(jq -r '[.tokens[] | select(.type == "systemd-tpm2")] as $t
    | if ($t | map(select(."tpm2_pcrlock" == true)) | length) > 0 then
        (if ($t | map(select(."tpm2-pin" == true)) | length) > 0 then "tpm-pin" else "tpm" end)
      elif ($t | length) == 0 then "passphrase" else "weak" end' <<<"$meta" 2>/dev/null || echo unknown)
fi
# The system image: /usr verified by dm-verity, IPE policy active, SELinux enforcing.
verity=false; veritysetup status usr 2>/dev/null | grep -q 'status:.*verified' && verity=true
ipe=false
for a in /sys/kernel/security/ipe/policies/*/active; do [ "$(cat "$a" 2>/dev/null)" = 1 ] && ipe=true; done
selinux=$(getenforce 2>/dev/null || echo Disabled)
# fwupd's Host Security ID (HSI:0 to HSI:4) and the platform checks that failed.
hsi=null; hsi_failed='[]'
if j=$(fwupdmgr security --json --force 2>/dev/null); then
  # The JSON has no HSI level; the daemon's property has it ("HSI:2 (v2.1.9)").
  hsi=$(busctl get-property org.freedesktop.fwupd / org.freedesktop.fwupd HostSecurityId 2>/dev/null |
        sed -n 's/^s "\(HSI:[0-9][^ "]*\).*/"\1"/p')
  [ -n "$hsi" ] || hsi=null
  # A check passed when fwupd flags it "success"; the result text alone does not say so
  # ("SPI write: not-enabled" is the good outcome).
  hsi_failed=$(jq -c '[.SecurityAttributes[]? | select((.HsiLevel // 0) > 0)
      | select((.Flags // []) | index("success") | not) | (.Name // .AppstreamId)] | unique' <<<"$j" 2>/dev/null) || hsi_failed='[]'
fi
# Forward Secure Sealing of the journal (tungsten-log-seal): the sealing key exists.
log_sealed=false; [ -e "/var/log/journal/$(cat /etc/machine-id)/fss" ] && log_sealed=true
# TungstenOS Secure Boot database updates (tungsten-secureboot-update.service).
sbdb=$(jq -c '{applied: (.applied // {} | length), pending: (.pending // []), refused: (.refused // [])}' \
  /var/lib/tungsten/secureboot-updates.json 2>/dev/null) || sbdb=null
[ -n "$sbdb" ] || sbdb=null
hardware=$(jq -n --argjson sbdb "$sbdb" --arg sb "$sb" --argjson tpm "$tpm" --argjson lockout "$lockout" --arg disk "$disk" \
  --argjson verity "$verity" --argjson ipe "$ipe" --arg selinux "$selinux" \
  --argjson hsi "$hsi" --argjson hsi_failed "$hsi_failed" --argjson log_sealed "$log_sealed" \
  '{secure_boot: $sb, tpm: $tpm, tpm_lockout: $lockout, disk: $disk, verity: $verity, ipe: $ipe,
    selinux: $selinux, hsi: $hsi, hsi_failed: $hsi_failed, secureboot_updates: $sbdb,
    log_sealed: $log_sealed}')

# Startup entries of logged-in users changed since they were accepted (persist-watch).
/usr/lib/tungsten/persist-watch check || :

tmp=$(mktemp "$DIR/.status.XXXXXX")
jq -n --argjson os_new "$os_new" --arg os_cur "$os_cur" --arg channel "$channel" --argjson flatpaks "${flatpaks:-0}" \
   --argjson firmware "$fw" --argjson hardware "$hardware" --arg checked "$(date -Iseconds)" \
   '{checked: $checked, os: {current: $os_cur, available: $os_new, channel: $channel}, flatpaks: $flatpaks,
     firmware: $firmware, hardware: $hardware}' > "$tmp"
chmod 0644 "$tmp"
mv -f "$tmp" "$OUT"
