#!/bin/bash
# Locks every gnome-keyring collection while the session is locked, so the secrets are not
# decrypted in memory while the machine is unattended. Watches the session's LockedHint
# and Lock signal at logind; the lock screen unlocks the keyrings again through PAM
# (/etc/pam.d/dankshell), otherwise the next app that needs a secret asks for the password.
# With USB auto-lock on (Tungsten Guard: ~/.config/tungsten/usb-autolock), it also locks
# the empty external USB ports while the session is locked, and unlocks them afterwards
# unless they were already locked by hand.
set -euo pipefail

# The user's graphical session at logind (services of the user manager do not get
# XDG_SESSION_ID): "user/self" resolves to the caller's user, its Display property is
# (session id, object path).
session=$(busctl --system get-property org.freedesktop.login1 /org/freedesktop/login1/user/self \
  org.freedesktop.login1.User Display | awk '{print $3}' | tr -d '"')
[ -n "$session" ] && [ "$session" != / ] || { echo "no graphical session at logind" >&2; exit 1; }

lock_keyrings() {
  local collections
  read -ra collections < <(busctl --user get-property org.freedesktop.secrets /org/freedesktop/secrets \
    org.freedesktop.Secret.Service Collections 2>/dev/null | cut -d' ' -f3-) || return 0
  [ ${#collections[@]} -gt 0 ] || return 0
  busctl --user call org.freedesktop.secrets /org/freedesktop/secrets \
    org.freedesktop.Secret.Service Lock ao "${#collections[@]}" "${collections[@]//\"/}" >/dev/null \
    && echo "locked ${#collections[@]} keyring collection(s)"
}

AUTOLOCK=${XDG_CONFIG_HOME:-$HOME/.config}/tungsten/usb-autolock
MARK=${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/tungsten-usb-autolocked

lock_usb() {
  [ -e "$AUTOLOCK" ] || return 0
  systemctl is-active -q tungsten-usb-lock.service && return 0   # locked by hand: leave it
  systemctl start tungsten-usb-lock.service && touch "$MARK" && echo "locked USB ports"
}

unlock_usb() {
  [ -e "$MARK" ] || return 0
  rm -f "$MARK"
  systemctl stop tungsten-usb-lock.service && echo "unlocked USB ports"
}

# Locked since boot (usb-lock boot): the first login ends it, unless auto-lock wants the
# ports locked anyway while the screen is locked (handled below).
[ -e /run/tungsten-usb-lock/boot ] && systemctl stop tungsten-usb-lock.service && echo "unlocked USB ports locked since boot"

gdbus monitor --system --dest org.freedesktop.login1 --object-path "$session" | while read -r line; do
  case $line in
    *"'LockedHint': <true>"*|*".Session.Lock ()"*) lock_keyrings; lock_usb ;;
    *"'LockedHint': <false>"*|*".Session.Unlock ()"*) unlock_usb ;;
  esac
done
