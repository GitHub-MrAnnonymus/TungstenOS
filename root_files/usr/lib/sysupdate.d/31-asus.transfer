# System extension, locked to the /usr version it was built with (SYSEXT_LEVEL).
[Transfer]
Features=asus
ProtectVersion=%A
Verify=yes

[Source]
Type=url-file
Path=@UPDATE_URL@
MatchPattern=asus_@v.raw

[Target]
Type=regular-file
Path=/var/lib/extensions.d
MatchPattern=asus_@v.raw
CurrentSymlink=/var/lib/extensions/asus.raw
Mode=0444
InstancesMax=2
