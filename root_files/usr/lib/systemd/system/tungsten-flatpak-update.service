# Keeps system-wide Flatpak apps and runtimes patched (there is no other updater for them).
# flatpak-update records which apps changed and the permissions they gained or lost, for
# Tungsten Guard (/run/tungsten-guard/flatpak-updates.json).
[Unit]
Description=Update Flatpak apps and runtimes
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/lib/tungsten/flatpak-update
