# Keeps system-wide Flatpak apps and runtimes patched (there is no other updater for them).
[Unit]
Description=Update Flatpak apps and runtimes
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
# Also applies the verified-only Flathub restriction to remotes added before it existed.
ExecStartPre=-/usr/bin/flatpak remote-modify --system --subset=verified flathub
ExecStart=/usr/bin/flatpak update --system --noninteractive --assumeyes
ExecStart=/usr/bin/flatpak uninstall --system --unused --noninteractive --assumeyes
