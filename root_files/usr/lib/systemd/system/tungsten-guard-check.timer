[Unit]
Description=Check for updates at boot and every hour

[Timer]
# Soon after boot, so the widget is not empty for minutes (it says "waiting for the first
# check" until then); the spread only keeps machines from checking in step.
OnBootSec=30s
OnUnitActiveSec=1h
RandomizedDelaySec=1min
Persistent=true

[Install]
WantedBy=timers.target
