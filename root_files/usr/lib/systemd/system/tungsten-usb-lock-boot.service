# Locks the empty external USB ports from boot until the first login (laptops by default;
# /etc/tungsten/usb-lock-at-boot). The session unlocks them (keyring-lock).
[Unit]
Description=Lock empty external USB ports until the first login
After=systemd-udev-settle.service systemd-udev-trigger.service
Before=display-manager.service greetd.service

[Service]
Type=oneshot
ExecStart=/usr/lib/tungsten/usb-lock boot

[Install]
WantedBy=multi-user.target
