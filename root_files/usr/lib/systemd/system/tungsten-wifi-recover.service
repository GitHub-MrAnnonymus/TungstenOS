[Unit]
Description=Recover Intel Wi-Fi cards that fail their first start
After=systemd-udev-trigger.service systemd-modules-load.service
Before=NetworkManager.service wpa_supplicant.service network-pre.target
Wants=network-pre.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/lib/tungsten/wifi-recover
# Two starts of up to 10 s each, then the reset and up to 10 s for the card to return.
TimeoutStartSec=60

[Install]
WantedBy=multi-user.target
