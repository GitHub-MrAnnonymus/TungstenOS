policy_module(tungsten, 1.0.0)

# User namespace creation is limited to domains granted
# `self:user_namespace create` (chromium_t, *_bubblewrap_t, container engines).
# Audit with: sesearch -A -c user_namespace -p create

# Desktop session rules (Hyprland, DankMaterialShell under staff_t) go here,
# derived from reviewed AVC denials.

gen_require(`
	attribute nsswitch_domain;
	type auditd_t, xdm_t, local_login_t, firewalld_t, kmod_t, NetworkManager_t, policykit_t, policykit_auth_t;
	type systemd_homed_t, systemd_homed_runtime_t;
	type systemd_userdbd_runtime_t, systemd_nsresourced_runtime_t;
	type proc_t, devpts_t, var_run_t, user_home_dir_t, xdg_cache_t;
	type sysctl_kernel_t, sysctl_vm_t, sysctl_vm_overcommit_t;
	type usbguard_t, systemd_pcrphase_t, staff_systemd_t, staff_t, systemd_homework_t;
	type systemd_hostnamed_t, var_lib_t, security_t, xdm_tmp_t, systemd_homed_record_t;
	type user_runtime_t, usbguard_tmpfs_t, fsadm_run_t, fuse_device_t;
')

# User and group lookups through nss-systemd (homed, userdbd, nsresourced varlink sockets)
allow { nsswitch_domain auditd_t NetworkManager_t policykit_t policykit_auth_t } { systemd_homed_runtime_t systemd_userdbd_runtime_t systemd_nsresourced_runtime_t }:sock_file { getattr read write };

# Polkit authentication of homed users (pam_systemd_home)
allow policykit_auth_t systemd_homed_t:fd use;
allow policykit_auth_t systemd_homed_runtime_t:fifo_file write;
allow policykit_t devpts_t:filesystem getattr;
dontaudit policykit_auth_t self:capability net_admin;

# firewalld
allow firewalld_t self:capability setpcap;
allow firewalld_t self:process { getcap setcap getsched };
allow firewalld_t proc_t:filesystem getattr;
allow firewalld_t { sysctl_kernel_t sysctl_vm_t }:dir search;
allow firewalld_t { sysctl_kernel_t sysctl_vm_overcommit_t }:file { open read };
dontaudit firewalld_t user_home_dir_t:dir search;

allow kmod_t var_run_t:file { getattr open read };
dontaudit NetworkManager_t xdg_cache_t:dir search;

# /usr/lib/tungsten/home-label (pam_exec at login) relabels homed homes with restorecon.
seutil_domtrans_setfiles(xdm_t)
seutil_domtrans_setfiles(local_login_t)

# Daemons that resolve users and groups (nss-systemd) but lack the attribute.
auth_use_nsswitch(usbguard_t)
auth_use_nsswitch(systemd_pcrphase_t)
auth_use_nsswitch(staff_systemd_t)

# systemd-pcrlock: predictions in /var/lib/pcrlock.d, the policy in /var/lib/systemd,
# UKIs and add-ons on the ESP, file labels for its own files.
files_rw_var_lib_dirs(systemd_pcrphase_t)
allow systemd_pcrphase_t var_lib_t:file { create getattr open read write rename unlink };
fs_read_dos_files(systemd_pcrphase_t)
fs_getattr_xattr_fs(systemd_pcrphase_t)
seutil_read_file_contexts(systemd_pcrphase_t)
allow systemd_pcrphase_t security_t:file map;

# systemd-homed / homework: mount and open the (now labeled) home, read OpenSSL config,
# and the per-user "dont-suspend" FIFO.
allow systemd_homework_t user_home_dir_t:dir { getattr mounton open read search };
miscfiles_read_generic_certs(systemd_homework_t)
allow systemd_homed_t systemd_homed_runtime_t:fifo_file { create getattr open read write unlink };

# homed's signed user record in the home (~/.identity*) may hold password hashes; file
# managers that list the home are refused quietly.
dontaudit staff_t systemd_homed_record_t:dir { getattr open read search };
dontaudit staff_t systemd_homed_record_t:file { getattr open read };

fs_rw_cgroup_files(systemd_hostnamed_t)

# No writable executable memory for user programs (allow_execmem stays off). libffi
# (GTK apps such as Nautilus) reads the allow_execmem boolean and then uses trampolines
# that need none; Qt's QML JIT is disabled with QV4_FORCE_INTERPRETER (uwsm env).
selinux_get_all_booleans(staff_t)

# PipeWire/WirePlumber read the user's and sessions' state from logind.
systemd_read_logind_runtime_files(staff_t)

# Hyprland replaces a stale Xwayland socket in /tmp/.X11-unix.
allow staff_t xdm_tmp_t:sock_file { getattr setattr unlink };

# udisks takes the cryptsetup lock in /run/cryptsetup.
optional_policy(`
	gen_require(`
		type devicekit_disk_t;
	')
	lvm_manage_runtime_files(devicekit_disk_t)
')

# Trivalent's launcher starts the browser through bwrap (to hide ld.so.preload);
# refpolicy's bubblewrap domain only returns to the user domain for bin_t, so the
# browser binary (chromium_exec_t) must enter chromium_t from there, under no_new_privs.
optional_policy(`
	gen_require(`
		type staff_bubblewrap_t, chromium_t;
	')
	chromium_domtrans(staff_bubblewrap_t)
	allow staff_bubblewrap_t chromium_t:process2 { nnp_transition nosuid_transition };
')

# The user's systemd: socket units of gpg-agent/keyboxd and gnome-keyring, the session
# environment uwsm writes to $XDG_RUNTIME_DIR, and passing sockets to user services.
optional_policy(`
	gen_require(`
		type gpg_runtime_t, gnome_keyring_tmp_t;
	')
	allow staff_systemd_t { gpg_runtime_t gnome_keyring_tmp_t }:dir { add_name create getattr search write };
	allow staff_systemd_t { gpg_runtime_t gnome_keyring_tmp_t }:sock_file { create getattr setattr unlink write };
')
userdom_read_user_tmp_files(staff_systemd_t)
allow staff_systemd_t staff_t:unix_stream_socket { connectto getattr read setattr write };

# PipeWire's sockets are created by the user's systemd (socket activation).
allow staff_t user_runtime_t:sock_file write;

# GVFS exposes its mounts to non-GIO programs through FUSE.
allow staff_t fuse_device_t:chr_file { getattr ioctl open read write };
fs_mount_fusefs(staff_t)
fs_unmount_fusefs(staff_t)

# lspci (GPU detection in Trivalent and others) reads modules.softdep.
modutils_read_module_deps(staff_t)

# usbguard-notifier talks to the daemon over its IPC socket and shared memory.
optional_policy(`
	gen_require(`
		type usbguard_t;
	')
	allow staff_t usbguard_t:unix_stream_socket connectto;
	allow staff_t usbguard_tmpfs_t:file { getattr map open read write };
')
files_read_etc_runtime_files(usbguard_t)

# homework runs fsck on the home before mounting it.
allow systemd_homework_t fsadm_run_t:dir { add_name getattr search write };
allow systemd_homework_t fsadm_run_t:file { create getattr lock open read write };

