policy_module(tungsten, 1.0.0)

# User namespace creation is limited to domains granted
# `self:user_namespace create` (chromium_t, *_bubblewrap_t, container engines).
# Audit with: sesearch -A -c user_namespace -p create

# Desktop session rules (Hyprland, DankMaterialShell under staff_t) go here,
# derived from reviewed AVC denials.

gen_require(`
	attribute nsswitch_domain;
	type auditd_t, xdm_t, local_login_t, firewalld_t, kmod_t, NetworkManager_t, policykit_t, policykit_auth_t;
	type systemd_homed_t, systemd_homed_runtime_t;
	type systemd_userdbd_runtime_t, systemd_nsresourced_runtime_t;
	type proc_t, devpts_t, var_run_t, user_home_dir_t, xdg_cache_t;
	type sysctl_kernel_t, sysctl_vm_t, sysctl_vm_overcommit_t;
	type usbguard_t, systemd_pcrphase_t, staff_systemd_t, staff_t, systemd_homework_t;
	type systemd_hostnamed_t, var_lib_t, security_t, xdm_tmp_t, systemd_homed_record_t;
	type user_runtime_t, usbguard_tmpfs_t, fsadm_run_t, fuse_device_t;
')

# User and group lookups through nss-systemd (homed, userdbd, nsresourced varlink sockets)
allow { nsswitch_domain auditd_t NetworkManager_t policykit_t policykit_auth_t } { systemd_homed_runtime_t systemd_userdbd_runtime_t systemd_nsresourced_runtime_t }:sock_file { getattr read write };

# Polkit authentication of homed users (pam_systemd_home)
allow policykit_auth_t systemd_homed_t:fd use;
allow policykit_auth_t systemd_homed_runtime_t:fifo_file write;
allow policykit_t devpts_t:filesystem getattr;
dontaudit policykit_auth_t self:capability net_admin;

# firewalld
allow firewalld_t self:capability setpcap;
allow firewalld_t self:process { getcap setcap getsched };
allow firewalld_t proc_t:filesystem getattr;
allow firewalld_t { sysctl_kernel_t sysctl_vm_t }:dir search;
allow firewalld_t { sysctl_kernel_t sysctl_vm_overcommit_t }:file { open read };
dontaudit firewalld_t user_home_dir_t:dir search;

allow kmod_t var_run_t:file { getattr open read };
dontaudit NetworkManager_t xdg_cache_t:dir search;

# /usr/lib/tungsten/home-label (pam_exec at login) relabels homed homes with restorecon.
seutil_domtrans_setfiles(xdm_t)
seutil_domtrans_setfiles(local_login_t)

# Daemons that resolve users and groups (nss-systemd) but lack the attribute.
auth_use_nsswitch(usbguard_t)
auth_use_nsswitch(systemd_pcrphase_t)
auth_use_nsswitch(staff_systemd_t)

# systemd-pcrlock: predictions in /var/lib/pcrlock.d, the policy in /var/lib/systemd,
# UKIs and add-ons on the ESP, file labels for its own files.
files_rw_var_lib_dirs(systemd_pcrphase_t)
allow systemd_pcrphase_t var_lib_t:file { create getattr link open read write rename setattr unlink };
fs_read_dos_files(systemd_pcrphase_t)
fs_getattr_xattr_fs(systemd_pcrphase_t)
seutil_read_file_contexts(systemd_pcrphase_t)
allow systemd_pcrphase_t security_t:file map;

# systemd-homed / homework: mount and open the (now labeled) home, read OpenSSL config,
# and the per-user "dont-suspend" FIFO.
allow systemd_homework_t user_home_dir_t:dir { getattr mounton open read search };
miscfiles_read_generic_certs(systemd_homework_t)
allow systemd_homed_t systemd_homed_runtime_t:fifo_file { create getattr open read write unlink };

# homed's signed user record in the home (~/.identity*) may hold password hashes; file
# managers that list the home are refused quietly.
dontaudit staff_t systemd_homed_record_t:dir { getattr open read search };
dontaudit staff_t systemd_homed_record_t:file { getattr open read };

fs_rw_cgroup_files(systemd_hostnamed_t)

# No writable executable memory for user programs (allow_execmem stays off). libffi
# (GTK apps such as Nautilus) reads the allow_execmem boolean and then uses trampolines
# that need none; Qt's QML JIT is disabled with QV4_FORCE_INTERPRETER (uwsm env).
selinux_get_all_booleans(staff_t)

# PipeWire/WirePlumber read the user's and sessions' state from logind.
systemd_read_logind_runtime_files(staff_t)

# Hyprland replaces a stale Xwayland socket in /tmp/.X11-unix.
allow staff_t xdm_tmp_t:sock_file { getattr setattr unlink };

# udisks takes the cryptsetup lock in /run/cryptsetup.
optional_policy(`
	gen_require(`
		type devicekit_disk_t;
	')
	lvm_manage_runtime_files(devicekit_disk_t)
')

# Trivalent's launcher starts the browser through bwrap (to hide ld.so.preload);
# refpolicy's bubblewrap domain only returns to the user domain for bin_t, so the
# browser binary (chromium_exec_t) must enter chromium_t from there, under no_new_privs.
optional_policy(`
	gen_require(`
		type staff_bubblewrap_t, chromium_t;
	')
	chromium_domtrans(staff_bubblewrap_t)
	allow staff_bubblewrap_t chromium_t:process2 { nnp_transition nosuid_transition };
')

# Trivalent's own names for what refpolicy labels for "chromium": its profile
# (~/.config/trivalent, created by the browser) and the cache its launcher creates in
# /var/tmp (XDG_CACHE_HOME=/var/tmp/trivalent_cache).
optional_policy(`
	gen_require(`
		type chromium_t, chromium_xdg_config_t, chromium_xdg_cache_t;
		type xdg_config_t, tmp_t, etc_t, locale_t, xkb_var_lib_t, gnome_xdg_config_t;
		type staff_gkeyringd_t, systemd_logind_t, systemd_logind_inhibit_runtime_t;
	')
	filetrans_pattern(chromium_t, xdg_config_t, chromium_xdg_config_t, dir, "trivalent")
	filetrans_pattern(staff_t, tmp_t, chromium_xdg_cache_t, dir, "trivalent_cache")
	allow staff_t chromium_xdg_cache_t:dir { create getattr search };

	# Small things the browser does: dconf settings, keyboard map cache, locale watch,
	# logind sleep inhibitor (video playback), gnome-keyring, inherited descriptors.
	allow chromium_t gnome_xdg_config_t:dir search;
	allow chromium_t gnome_xdg_config_t:file { getattr map open read };
	allow chromium_t xkb_var_lib_t:lnk_file read;
	allow chromium_t locale_t:dir watch;
	allow chromium_t etc_t:file map;
	allow chromium_t systemd_logind_t:fd use;
	allow chromium_t systemd_logind_inhibit_runtime_t:fifo_file write;
	allow staff_gkeyringd_t chromium_t:fd use;
	allow staff_gkeyringd_t chromium_t:fifo_file write;
	allow staff_t chromium_t:fd use;
	allow chromium_t staff_t:netlink_kobject_uevent_socket { read write };
')

# The user's systemd: socket units of gpg-agent/keyboxd and gnome-keyring, the session
# environment uwsm writes to $XDG_RUNTIME_DIR, and passing sockets to user services.
optional_policy(`
	gen_require(`
		type gpg_runtime_t, gnome_keyring_tmp_t;
	')
	allow staff_systemd_t { gpg_runtime_t gnome_keyring_tmp_t }:dir { add_name create getattr search write };
	allow staff_systemd_t { gpg_runtime_t gnome_keyring_tmp_t }:sock_file { create getattr setattr unlink write };
')
userdom_read_user_tmp_files(staff_systemd_t)
allow staff_systemd_t staff_t:unix_stream_socket { connectto getattr read setattr write };

# PipeWire's sockets are created by the user's systemd (socket activation).
allow staff_t user_runtime_t:sock_file write;

# GVFS exposes its mounts to non-GIO programs through FUSE.
allow staff_t fuse_device_t:chr_file { getattr ioctl open read write };
fs_mount_fusefs(staff_t)
fs_unmount_fusefs(staff_t)

# lspci (GPU detection in Trivalent and others) reads modules.softdep.
modutils_read_module_deps(staff_t)

# usbguard-notifier talks to the daemon over its IPC socket and shared memory.
optional_policy(`
	gen_require(`
		type usbguard_t;
	')
	allow staff_t usbguard_t:unix_stream_socket connectto;
	allow staff_t usbguard_tmpfs_t:file { getattr map open read write };
')
files_read_etc_runtime_files(usbguard_t)

# homework runs fsck on the home before mounting it.
allow systemd_homework_t fsadm_run_t:dir { add_name getattr search write };
allow systemd_homework_t fsadm_run_t:file { create getattr lock open read write };


########################################
# Rules from permissive-mode testing (tungsten-debug denial lists), needed for enforcing.

gen_require(`
	type getty_t, tmpfs_t, init_t, init_runtime_t, lastlog_t, systemd_logind_t;
	type staff_dbusd_t, staff_gkeyringd_t, system_dbusd_t, sysadm_t;
	type user_devpts_t, user_tty_device_t, user_home_t, user_tmp_t, user_tmpfs_t;
	type cert_t, cgroup_t, locale_t, nsfs_t, sysctl_fs_t, unlabeled_t;
	type systemd_homed_storage_t, systemd_log_t, systemd_user_runtime_dir_t, udev_t;
	type event_device_t, mount_runtime_t, node_t, unreserved_port_t;
	type systemd_sessions_runtime_t, systemd_unit_t, systemd_user_tmpfs_t, systemd_user_runtime_t;
	type xdg_config_t, xdg_data_t, device_t, bin_t, auditd_etc_t, shell_exec_t, var_t;
	attribute exec_type;
	role sysadm_r;
')

# --- run0 ---
# systemd runs run0's PAM session in a child of PID 1, so pam_selinux picks root's
# default context "from init_t". build.sh points that at sysadm_t (refpolicy has the
# user manager domain sysadm_systemd_t there). run0 executes the requested program
# directly, so any program is an entrypoint for the admin domain.
role sysadm_r types sysadm_t;
allow init_t sysadm_t:process { transition noatsecure rlimitinh siginh setsched };
allow sysadm_t exec_type:file entrypoint;
allow sysadm_t init_t:fd use;
allow sysadm_t init_t:process sigchld;
allow sysadm_t init_t:unix_stream_socket { getattr ioctl read write };
# The terminal and redirections of the calling session.
allow sysadm_t { local_login_t staff_t xdm_t }:fd use;
allow sysadm_t { user_devpts_t user_tty_device_t }:chr_file { getattr ioctl open read write };
allow sysadm_t user_home_t:file { append getattr ioctl write };

# --- Console and graphical login ---
files_read_etc_runtime_files(auditd_t)
files_read_etc_runtime_files(policykit_t)
allow getty_t tmpfs_t:dir { getattr open read search };
corecmd_exec_bin(local_login_t)
allow local_login_t init_runtime_t:sock_file write;
allow local_login_t lastlog_t:dir read;
allow local_login_t systemd_logind_t:unix_stream_socket connectto;
allow local_login_t systemd_homed_runtime_t:fifo_file write;
allow local_login_t systemd_homed_t:fd use;
allow local_login_t tmpfs_t:dir read;
allow local_login_t xdm_t:key search;

# --- systemd-homed / homework (privileged home management) ---
miscfiles_read_generic_certs(systemd_homed_t)
allow systemd_homed_t cgroup_t:file { getattr open read write };
allow systemd_homed_t locale_t:dir search;
allow systemd_homed_t locale_t:file { getattr map open read };
allow systemd_homed_t nsfs_t:file getattr;
allow systemd_homed_t self:process getcap;
allow systemd_homed_t systemd_homed_storage_t:file write;
allow systemd_homed_t systemd_homework_t:fd use;
allow systemd_homed_t user_home_dir_t:dir { getattr open read };
allow systemd_homed_t var_t:dir read;
allow system_dbusd_t systemd_homed_runtime_t:fifo_file write;
allow system_dbusd_t systemd_homed_t:fd use;
allow systemd_homework_t init_t:key write;
allow systemd_homework_t locale_t:dir search;
allow systemd_homework_t locale_t:file { getattr map open read };
allow systemd_homework_t nsfs_t:file { getattr open read };
allow systemd_homework_t self:capability { dac_read_search setfcap setgid setuid };
allow systemd_homework_t self:cap_userns { sys_admin sys_ptrace };
allow systemd_homework_t self:process { getcap sigkill };
allow systemd_homework_t self:user_namespace create;
allow systemd_homework_t sysctl_fs_t:dir search;
allow systemd_homework_t sysctl_fs_t:file { getattr ioctl open read };
allow systemd_homework_t systemd_homed_runtime_t:dir mounton;
allow systemd_homework_t systemd_homed_t:unix_dgram_socket sendto;
allow systemd_homework_t unlabeled_t:dir { mounton search };
allow udev_t systemd_homed_storage_t:file getattr;

# --- Other system services ---
fs_rw_cgroup_files(systemd_logind_t)
allow systemd_pcrphase_t nsfs_t:file getattr;
# The userspace measurement log (/run/log/systemd/tpm2-measure.log) for predictions.
allow systemd_pcrphase_t systemd_log_t:file { getattr open read };
allow systemd_user_runtime_dir_t tmpfs_t:filesystem { quotaget quotamod };
allow systemd_user_runtime_dir_t user_tmp_t:lnk_file unlink;

# --- The user's systemd and session bus ---
allow staff_systemd_t staff_t:fd use;
allow staff_systemd_t staff_t:fifo_file write;
allow staff_systemd_t staff_t:process2 nnp_transition;
allow staff_systemd_t staff_gkeyringd_t:unix_stream_socket { bind create getattr listen setopt };
allow staff_t staff_systemd_t:unix_dgram_socket sendto;
allow staff_dbusd_t staff_t:unix_stream_socket { accept getattr getopt read write };

# --- The desktop session (staff_t) ---
# File change notifications (inotify) on the user's own and system files.
allow staff_t { bin_t device_t user_runtime_t systemd_user_runtime_t systemd_sessions_runtime_t user_tmp_t }:dir watch;
allow staff_t { xdg_config_t xdg_data_t user_tmp_t mount_runtime_t }:file watch;
allow staff_t systemd_sessions_runtime_t:file { getattr open read };
allow staff_t mount_runtime_t:file { getattr open read };
allow staff_t systemd_unit_t:lnk_file read;
allow staff_t nsfs_t:file getattr;
# Input devices handed over by logind (keyboard LEDs).
allow staff_t event_device_t:chr_file write;
# Shared memory with the user's systemd, and memory-mapping own files.
allow staff_t systemd_user_tmpfs_t:file { ioctl map read write };
allow staff_t { user_home_t user_tmp_t }:file map;
# libffi without writable+executable memory: code mapped from a second shm mapping.
allow staff_t user_tmpfs_t:file execmod;
# xdg-document-portal mounts its FUSE file system in $XDG_RUNTIME_DIR.
allow staff_t user_tmp_t:dir mounton;
# The polkit authentication agent and helper.
allow staff_t policykit_auth_t:unix_stream_socket connectto;
allow staff_t var_run_t:sock_file write;
# Listening sockets on unprivileged ports (KDE Connect: 1714-1764).
allow staff_t node_t:{ tcp_socket udp_socket } node_bind;
allow staff_t unreserved_port_t:{ tcp_socket udp_socket } name_bind;
dontaudit staff_t auditd_etc_t:dir { getattr open read search };
dontaudit staff_t auditd_etc_t:file getattr;
dontaudit staff_t systemd_homed_record_t:dir write;
dontaudit staff_t systemd_homed_record_t:file write;

# --- bwrap (Flatpak, glycin, Trivalent's launcher) ---
optional_policy(`
	gen_require(`
		type staff_bubblewrap_t;
	')
	allow staff_bubblewrap_t self:process getsched;
	allow staff_bubblewrap_t staff_t:netlink_kobject_uevent_socket { read write };
	allow staff_bubblewrap_t user_tmpfs_t:file map;
')

# --- Trivalent (chromium_t) ---
optional_policy(`
	gen_require(`
		type chromium_t, chromium_xdg_config_t;
	')
	# NSS certificate database in ~/.local/share/pki
	filetrans_pattern(chromium_t, xdg_data_t, chromium_xdg_config_t, dir, "pki")
	# Wayland socket and buffers shared with the compositor
	allow chromium_t user_tmp_t:sock_file write;
	allow chromium_t user_tmpfs_t:file { getattr map read };
	allow chromium_t staff_t:file { getattr open read };
')

optional_policy(`
	gen_require(`
		type gpg_t;
	')
	allow staff_systemd_t gpg_t:unix_stream_socket { bind create getattr listen setopt };
')

optional_policy(`
	gen_require(`
		type virt_etc_rw_t;
	')
	allow staff_t virt_etc_rw_t:lnk_file read;
')

########################################
# From the first enforcing boot and a permissive boot with dontaudit rules disabled.

gen_require(`
	type auditctl_t, auditd_etc_t, proc_t, lvm_t, initrc_t, boot_t, security_t;
	type selinux_config_t, systemd_coredump_t, systemd_machined_t, vsock_device_t;
	type systemd_nsresourced_t, modules_object_t, systemd_notify_exec_t, howl_port_t;
	type usbguard_tmpfs_t, systemd_logind_runtime_t, fs_t;
')

# auditd's rules are loaded by auditctl at boot.
allow auditctl_t auditd_etc_t:file map;
allow auditctl_t proc_t:filesystem getattr;

# cryptsetup (lvm_t) and udev cookies created by boot scripts.
allow lvm_t initrc_t:sem { associate read unix_read unix_write write };

# polkit checks the SELinux state.
selinux_get_fs_mount(policykit_t)
allow { policykit_t policykit_auth_t } selinux_config_t:dir search;

# systemd-tpm2-setup and systemd-pcrlock: the ESP mount point (/boot), the firmware
# event log in securityfs, SELinux configuration for labeling their files.
files_list_boot(systemd_pcrphase_t)
fs_list_dos(systemd_pcrphase_t)
allow systemd_pcrphase_t security_t:dir search;
allow systemd_pcrphase_t security_t:file { getattr open read };
seutil_read_config(systemd_pcrphase_t)
seutil_search_default_contexts(systemd_pcrphase_t)

# systemd-coredump checks the SELinux status before labeling.
selinux_use_status_page(systemd_coredump_t)

# homed / homework
allow systemd_homed_t self:capability sys_resource;
allow systemd_homework_t self:capability sys_resource;
allow systemd_homework_t init_t:key search;
allow systemd_homework_t selinux_config_t:dir search;

# machined (VM and container registration) and nsresourced
fs_rw_cgroup_files(systemd_machined_t)
allow systemd_machined_t vsock_device_t:chr_file { ioctl open read };
allow systemd_nsresourced_t fs_t:filesystem getattr;

# The desktop session: delegated cgroup (uwsm, systemd-run --user), systemd-notify
# (uwsm), mDNS for KDE Connect discovery, the user's own processes in the bwrap and
# user manager domains (xdg-desktop-portal identifies sandboxed apps through /proc),
# logind state, usbguard-notifier's shared memory directory, libffi trampolines.
fs_rw_cgroup_files(staff_t)
can_exec(staff_t, systemd_notify_exec_t)
allow staff_t howl_port_t:udp_socket name_bind;
allow staff_t modules_object_t:dir search;
ps_process_pattern(staff_t, staff_systemd_t)
allow staff_t systemd_logind_runtime_t:dir { getattr open read search };
allow staff_t systemd_sessions_runtime_t:dir { getattr open read search };
allow staff_t usbguard_tmpfs_t:dir search;
allow staff_t user_tmpfs_t:file execute;
systemd_connect_machined(staff_t)

optional_policy(`
	gen_require(`
		type staff_bubblewrap_t;
	')
	ps_process_pattern(staff_t, staff_bubblewrap_t)
	allow staff_t staff_bubblewrap_t:fifo_file { getattr write };
	# bwrap itself: chroot into the new root, process limits, its own pipes
	allow staff_bubblewrap_t self:cap_userns sys_chroot;
	allow staff_bubblewrap_t self:process { getsched setrlimit setsched signal };
	allow staff_bubblewrap_t self:fifo_file { read write };
	fs_getattr_xattr_fs(staff_bubblewrap_t)
	fs_getattr_tmpfs(staff_bubblewrap_t)
	dev_read_urand(staff_bubblewrap_t)
	# D-Bus activation and gnome-keyring from inside a sandbox
	allow { staff_dbusd_t staff_gkeyringd_t } staff_bubblewrap_t:fd use;
	allow { staff_dbusd_t staff_gkeyringd_t } staff_bubblewrap_t:fifo_file write;
')

# fstab bind-mounts /var/lib/flatpak (labeled bin_t, see tungsten.fc) onto itself to make
# it the one executable writable location; systemd and mount(8) need mounton there.
gen_require(`
	type mount_t;
')
allow { init_t mount_t } bin_t:dir mounton;


########################################
# From the image's own policy in permissive mode (systemd unit checks, system tools).

gen_require(`
	type syslogd_t, systemd_tmpfiles_t, systemd_sysctl_t, systemd_generator_t;
	type binfmt_misc_fs_t, dosfs_t, systemd_user_unit_t;
	class service { start status };
	class system { start status };
')

# systemd checks access to units: the system bus (activation), polkit, and uwsm, which
# lists units at session start.
init_get_all_units_status(system_dbusd_t)
init_get_system_status(system_dbusd_t)
init_get_all_units_status(policykit_t)
init_get_all_units_status(staff_t)
# The session bus starts user services (D-Bus activation, e.g. gvfs-daemon) through
# the user's systemd, also as transient units.
allow staff_dbusd_t systemd_user_unit_t:service { start status };
allow staff_dbusd_t staff_systemd_t:system { start status };

# journald: credentials in /run/credentials, memory pressure in its cgroup.
allow syslogd_t tmpfs_t:dir search;
fs_rw_cgroup_files(syslogd_t)

# systemd-tmpfiles creates and fixes up directories of other packages at boot.
corecmd_search_bin(systemd_tmpfiles_t)
allow systemd_tmpfiles_t bin_t:dir { add_name write };
allow systemd_tmpfiles_t auditd_etc_t:dir { getattr search };
allow systemd_tmpfiles_t auditd_etc_t:file getattr;
allow systemd_tmpfiles_t security_t:dir search;
allow systemd_tmpfiles_t security_t:file { getattr setattr };
allow systemd_tmpfiles_t user_home_t:dir { add_name getattr open read search setattr write };
allow systemd_tmpfiles_t user_home_t:file { create getattr open setattr write };
dontaudit systemd_tmpfiles_t dosfs_t:dir setattr;
optional_policy(`
	gen_require(`
		type devicekit_var_lib_t, uuidd_var_lib_t, virt_var_lib_t;
	')
	allow systemd_tmpfiles_t { devicekit_var_lib_t uuidd_var_lib_t virt_var_lib_t }:dir { getattr open read search setattr };
')
# Flatpak reads the global override written by tmpfiles (see tungsten.fc).
files_read_var_lib_files(staff_t)

# systemd-sysctl writes drop-ins in /run/sysctl.d (e.g. systemd-coredump's core pattern).
allow systemd_sysctl_t var_run_t:dir { add_name remove_name search write };
allow systemd_sysctl_t var_run_t:file { create getattr open rename setattr unlink write };
allow systemd_sysctl_t binfmt_misc_fs_t:dir search;

# udev inspects the loop devices of system extensions (files in /var/lib/extensions.d).
allow udev_t var_lib_t:file getattr;

# systemd-coredump: its runtime directory, file labels.
allow systemd_coredump_t init_runtime_t:dir { add_name create search write };
seutil_read_file_contexts(systemd_coredump_t)

# systemd-pcrlock removes component directories it regenerates.
allow systemd_pcrphase_t var_lib_t:dir { create remove_name rmdir };

# The flatpak generator looks into root's cache.
dontaudit systemd_generator_t xdg_cache_t:dir search;

########################################
# From a fresh install of the current image in permissive mode.

gen_require(`
	type gnome_xdg_data_t, shadow_t, sysfs_t, kernel_t, systemd_userdbd_t;
	type systemd_modules_load_t, var_spool_t, tmp_t, xkb_var_lib_t;
	class dbus send_msg;
	class system reload;
')

# systemd-homework creates the home's file system and copies the skeleton into it
# before it is labeled (tungsten home-label relabels it at the first login).
allow systemd_homework_t unlabeled_t:dir { add_name create getattr open read remove_name rename search setattr write };
allow systemd_homework_t unlabeled_t:file { create getattr open read rename setattr unlink write };
allow systemd_homework_t unlabeled_t:lnk_file { create getattr read setattr };
allow systemd_homework_t var_t:dir { getattr open read search };
allow systemd_homework_t self:process setsched;
allow systemd_homework_t self:netlink_kobject_uevent_socket { create bind getattr read setopt };
allow systemd_homed_t unlabeled_t:dir getattr;
allow systemd_homed_t var_t:dir { add_name create getattr open read search write };
allow systemd_homed_t { var_spool_t tmp_t }:dir { getattr open read search };
auth_use_nsswitch(systemd_homed_t)
allow policykit_auth_t systemd_homed_t:dbus send_msg;

# Trivalent: NSS database in ~/.local/share/pki (created below gnome's data directory),
# dconf, its app scope (a transient unit) and logind/systemd over D-Bus.
optional_policy(`
	gen_require(`
		type chromium_t, chromium_xdg_config_t;
	')
	filetrans_pattern(chromium_t, gnome_xdg_data_t, chromium_xdg_config_t, dir, "pki")
	allow chromium_t gnome_xdg_data_t:dir { getattr search };
	allow chromium_t user_tmp_t:file { getattr map open read write };
	allow chromium_t staff_systemd_t:system { start status };
	allow chromium_t { systemd_logind_t init_t }:dbus send_msg;
	dontaudit chromium_t proc_t:filesystem associate;
')

# The session
allow staff_systemd_t gnome_xdg_data_t:dir { getattr search };
allow staff_dbusd_t staff_systemd_t:system reload;
allow staff_t initrc_t:dbus send_msg;

# systemd-tmpfiles
allow systemd_tmpfiles_t tmpfs_t:dir { add_name write };
allow systemd_tmpfiles_t tmpfs_t:lnk_file read;
allow systemd_tmpfiles_t bin_t:file { getattr open read };
allow systemd_tmpfiles_t auditd_etc_t:file { open read };
# Checks permissions on /etc/gshadow; reading shadow files is reserved (neverallow).
allow systemd_tmpfiles_t shadow_t:file getattr;
dontaudit systemd_tmpfiles_t shadow_t:file { open read };
allow systemd_tmpfiles_t var_lib_t:file { create getattr open setattr write };
allow systemd_tmpfiles_t xkb_var_lib_t:dir { getattr open read search };
optional_policy(`
	gen_require(`
		type plymouthd_var_lib_t, NetworkManager_var_lib_t, accountsd_var_lib_t;
	')
	allow systemd_tmpfiles_t { plymouthd_var_lib_t NetworkManager_var_lib_t accountsd_var_lib_t }:dir { getattr open read search };
')

# systemd-sysctl, udev, nsresourced, userdbd, modules-load
allow systemd_sysctl_t var_run_t:file read;
allow systemd_sysctl_t binfmt_misc_fs_t:file { open read write };
allow udev_t kernel_t:netlink_kobject_uevent_socket { read write };
allow udev_t tmpfs_t:file { read write };
fs_rw_cgroup_files({ systemd_userdbd_t systemd_nsresourced_t })
fs_read_cgroup_files(systemd_modules_load_t)
# nsresourced loads its BPF program (kernel BTF in /sys/kernel/btf/vmlinux)
allow systemd_nsresourced_t sysfs_t:file { getattr open read };
allow systemd_nsresourced_t self:capability2 perfmon;

########################################
# From the first boot with (nearly) complete rules, in permissive mode.

gen_require(`
	type home_root_t, policy_config_t, virt_var_lib_t;
	class system { start status };
')

# run0 asks PID 1 to start a transient unit (polkit decides whether it may); polkit
# looks up the unit of the calling process.
allow staff_t init_t:system start;
init_start_transient_units(staff_t)
init_get_system_status(policykit_t)

# run0 tungsten-tpm-enroll / tungsten-audit: the TPM, as root in sysadm_t.
dev_rw_tpm(sysadm_t)
# tungsten-audit runs bootctl status as the user (EFI variables are world-readable).
fs_read_efivarfs_files(staff_t)
dontaudit staff_t policy_config_t:dir getattr;

allow staff_dbusd_t gnome_xdg_data_t:dir search;
allow systemd_homework_t home_root_t:dir mounton;
allow systemd_nsresourced_t sysfs_t:file map;
allow udev_t kernel_t:netlink_kobject_uevent_socket getattr;
allow udev_t tmpfs_t:file getattr;
allow systemd_sysctl_t var_run_t:dir create;
allow systemd_sysctl_t binfmt_misc_fs_t:file getattr;
allow systemd_coredump_t init_runtime_t:sock_file { create getattr setattr unlink };
allow systemd_tmpfiles_t tmpfs_t:lnk_file { create getattr };
allow systemd_tmpfiles_t init_runtime_t:sock_file getattr;
allow systemd_tmpfiles_t virt_var_lib_t:dir { relabelfrom relabelto };

# libvirtd reads its secrets encryption key from its systemd credentials directory.
optional_policy(`
	gen_require(`
		type virtd_t, init_tmpfs_t;
	')
	allow virtd_t init_tmpfs_t:file { getattr open read };
')

########################################
# From the first enforcing boot (denials hidden by dontaudit rules).

gen_require(`
	type mount_t, fuse_device_t;
	role staff_r;
')

# run0 asks PID 1 over D-Bus to start its unit; a denied message makes dbus-broker drop
# the connection ("Connection reset by peer") without an audit record.
init_dbus_chat(staff_t)

# systemd-coredump reads /etc/selinux/config to find the policy for labeling (without it:
# "Failed to initialize SELinux labeling handle: No such file or directory").
seutil_read_config(systemd_coredump_t)
seutil_search_default_contexts(systemd_coredump_t)

# User FUSE mounts (xdg-document-portal, gvfsd-fuse): fusermount3 carries
# cap_sys_admin as a file capability. Run it in the mount domain, which may use that
# capability, instead of granting sys_admin to staff_t. It mounts in $XDG_RUNTIME_DIR and
# hands the /dev/fuse descriptor back over the caller's socket.
mount_run(staff_t, staff_r)
allow mount_t fuse_device_t:chr_file { getattr ioctl open read write };
allow mount_t user_tmp_t:dir { getattr mounton search };
allow mount_t staff_t:fd use;
allow mount_t staff_t:unix_stream_socket { getattr read write };
allow mount_t staff_t:fifo_file { read write };
# The portals and gvfs are started by the user's systemd, so fusermount3 inherits its
# descriptors; it checks that the mount point is writable; the user manager watches it.
allow mount_t staff_systemd_t:fd use;
allow mount_t staff_systemd_t:unix_stream_socket { getattr read write };
allow mount_t user_tmp_t:dir write;
ps_process_pattern(staff_systemd_t, mount_t)

# fontconfig tries to update the system font cache's timestamp; users may not change it.
gen_require(`
	type fonts_cache_t;
')
dontaudit staff_t fonts_cache_t:dir setattr;
optional_policy(`
	gen_require(`
		type chromium_t;
	')
	dontaudit chromium_t fonts_cache_t:dir setattr;
')

# run0 passes its stdin/stdout/stderr (terminal, pipe or redirected file) with the
# StartTransientUnit call; dbus-broker receives the descriptors and hands them to PID 1,
# which gives them to the command in sysadm_t. A refused descriptor makes the broker drop
# the connection ("Connection reset by peer"), with the denial hidden by dontaudit.
allow { system_dbusd_t init_t sysadm_t } staff_t:fd use;
allow { system_dbusd_t init_t sysadm_t } staff_t:fifo_file { getattr ioctl read write };
allow { system_dbusd_t init_t } { user_devpts_t user_tty_device_t }:chr_file { getattr ioctl read write };
allow { system_dbusd_t init_t sysadm_t } { user_home_t user_tmp_t }:file { append getattr ioctl read write };


# run0's password agent watches /run/systemd/ask-password for prompts of system services.
gen_require(`
	type systemd_passwd_runtime_t;
')
allow staff_t systemd_passwd_runtime_t:dir { getattr open read search watch };

# From a fresh install (permissive boot).

gen_require(`
	type chkpwd_t, home_root_t, mount_t, plymouth_t, tty_device_t, unlabeled_t, var_t;
	type systemd_generator_t, systemd_machine_id_setup_t, fs_t, nsfs_t;
	class process2 nnp_transition;
')

# Polkit's password helper (run0) runs with NoNewPrivileges: it checks local passwords
# through unix_chkpwd, and pam_faillock keeps its failure counters in /run/faillock.
allow policykit_auth_t chkpwd_t:process2 nnp_transition;
auth_manage_faillog(policykit_auth_t)
allow policykit_auth_t self:capability { chown fowner };

# homework creates the home's mount point in /home and copies the skeleton into the
# not yet labeled file system; homed removes a home's leftover directory in /var/cache.
allow systemd_homework_t home_root_t:dir { add_name create remove_name rmdir setattr write };
allow systemd_homework_t unlabeled_t:{ dir file } ioctl;
allow systemd_homework_t self:netlink_kobject_uevent_socket getopt;
allow systemd_homed_t var_t:dir { remove_name rmdir };

# gvfsd-fuse and the document portal use the /dev/fuse descriptor fusermount3 hands back.
allow staff_t mount_t:fd use;

# firstboot-users ends Plymouth's splash on tty1 to prompt for the accounts.
term_use_unallocated_ttys(plymouth_t)

# systemd-machine-id-setup checks its capabilities and which file system /etc is on.
allow systemd_machine_id_setup_t self:process getcap;
allow systemd_machine_id_setup_t { fs_t nsfs_t }:filesystem getattr;

# The flatpak generator tries to create root's cache; it works without it.
dontaudit systemd_generator_t user_home_dir_t:dir { add_name create write };
# On the first boot /root does not exist yet; it tries to create it.
gen_require(`
	type root_t;
')
dontaudit systemd_generator_t root_t:dir { add_name create write };

# The lock screen (quickshell, staff_t) authenticates through pam_systemd_home, which
# hands it homed's "don't suspend" pipe; homework reads the home's volume key it put in
# the kernel keyring when it resizes an active home.
allow staff_t systemd_homed_t:fd use;
allow staff_t systemd_homed_runtime_t:fifo_file write;
allow systemd_homework_t self:key read;

# home-label (pam_exec, in the login domain) checks whether a new home is still
# unlabeled before it runs restorecon.
allow { local_login_t xdm_t } unlabeled_t:dir { getattr search };

# Removing /run/user/<uid> at logout looks at what is in it.
gen_require(`
	type systemd_user_runtime_dir_t, gconf_tmp_t;
')
allow systemd_user_runtime_dir_t gconf_tmp_t:dir getattr;

# homectl: the administrator manages accounts, the user reads and changes their own
# (homed asks polkit for every change).
systemd_dbus_chat_homed({ sysadm_t staff_t })
systemd_stream_connect_homed(sysadm_t)

# systemd-tmpfiles-clean looks into audit's directories and at the journal's socket;
# nothing there is ours to clean.
gen_require(`
	type auditd_etc_t, auditd_log_t, syslogd_runtime_t;
')
dontaudit systemd_tmpfiles_t { auditd_etc_t auditd_log_t }:dir read;
dontaudit systemd_tmpfiles_t syslogd_runtime_t:sock_file getattr;

# On the first boot the root partition's /bin, /lib64, ... links (created in the initrd)
# are still unlabeled when PID 1 starts the generators: the kernel resolves the program
# loader (/lib64/ld-linux-x86-64.so.2) and #!/bin/sh through them.
allow init_t unlabeled_t:lnk_file { getattr read };

# firstboot-users logs systemd-machine-id-setup's output to a file and runs it from the
# console; it needs neither.
dontaudit systemd_machine_id_setup_t var_lib_t:file append;
dontaudit systemd_machine_id_setup_t tty_device_t:chr_file { read write };

# glibc enables the shadow stack (SHSTK) for any program whose startup objects are all
# marked, and refuses a later dlopen() of an unmarked library unless
# GLIBC_TUNABLES=glibc.cpu.x86_shstk=permissive (system.conf) applies. Domain transitions
# set AT_SECURE, which makes glibc ignore GLIBC_TUNABLES; systemd-modules-load and udev
# dlopen() libkmod, which needs the unmarked libzstd. Let PID 1's environment through.
gen_require(`
	type udev_t, systemd_modules_load_t;
')
allow init_t { systemd_modules_load_t udev_t }:process noatsecure;

# systemctl in the admin shell runs the password agent, which watches the admin's
# ask-password directory in /run/user/0.
allow sysadm_t user_tmp_t:dir watch;

# pacman (read-only database) lets gpg try to update the keyring's trust database.
gen_require(`
	type gpg_t;
')
dontaudit gpg_t etc_t:file write;

# systemctl --machine=user@ from the admin shell: dbus-broker receives its socket.
allow system_dbusd_t sysadm_t:fd use;
allow system_dbusd_t sysadm_t:unix_stream_socket { getattr read write };

# The session queries firewalld (status, zones); firewalld asks polkit before changes.
optional_policy(`
	firewalld_dbus_chat(staff_t)
')

# Bazaar (libdex) copies app icons from the system Flatpak directory with their
# metadata; restoring the source label (bin_t) on the copy in the cache is refused and
# not needed.
dontaudit staff_t bin_t:file relabelto;

# Chromium writes its own /proc/<pid> settings (oom_score_adj).
gen_require(`
	type proc_t;
')
dontaudit staff_t proc_t:filesystem associate;

# The administrator manages the disk encryption: tungsten-tpm-enroll reads the LUKS
# header (cryptsetup luksDump) and adds the TPM key slot (systemd-cryptenroll) on the
# root partition's block device. The everyday account (staff_t) has no raw disk access.
storage_raw_rw_fixed_disk(sysadm_t)

# The session bus (dbus-broker) watches the D-Bus service directories, including Flatpak's
# exports (/var/lib/flatpak/exports/share/dbus-1/services, bin_t), and reads the service
# files (links into the app). A refused watch is fatal: the first Flatpak with a D-Bus
# service made every session fail to start.
allow staff_dbusd_t bin_t:dir { getattr open read search watch };
allow staff_dbusd_t bin_t:lnk_file { getattr read };
allow staff_dbusd_t bin_t:file { getattr open read };

# bwrap locks the Flatpak runtime's /usr/.ref (bin_t) while an app uses that runtime, so
# flatpak does not remove it underneath; refused, no Flatpak app starts.
gen_require(`
	type staff_bubblewrap_t;
')
allow staff_bubblewrap_t bin_t:file lock;
