# Trivalent runs in the chromium domain (its sandbox needs user namespaces).
/usr/lib/trivalent/trivalent			--	gen_context(system_u:object_r:chromium_exec_t)
/usr/lib/trivalent/chrome_crashpad_handler	--	gen_context(system_u:object_r:chromium_exec_t)
/usr/lib/trivalent/trivalent\.sh		--	gen_context(system_u:object_r:bin_t)

HOME_DIR/\.config/trivalent(/.*)?			gen_context(system_u:object_r:chromium_xdg_config_t)
HOME_DIR/\.cache/trivalent(/.*)?			gen_context(system_u:object_r:chromium_xdg_cache_t)

# Display manager: xdm_t may transition into user domains at login.
/usr/bin/greetd					--	gen_context(system_u:object_r:xdm_exec_t)

# Flatpak deployments are hardlinks into the ostree repo, so the tree shares one type.
/var/lib/flatpak(/.*)?					gen_context(system_u:object_r:bin_t)

# Arch installs helper programs directly in /usr/lib (lib_t). Label the user-session
# daemons as programs, as refpolicy does on other distributions' paths, so the user's
# systemd starts them in the user domain instead of its own.
/usr/lib/at-spi-bus-launcher			--	gen_context(system_u:object_r:bin_t)
/usr/lib/at-spi2-registryd			--	gen_context(system_u:object_r:bin_t)
/usr/lib/dconf-service				--	gen_context(system_u:object_r:bin_t)
/usr/lib/flatpak-(portal|session-helper|oci-authenticator)	--	gen_context(system_u:object_r:bin_t)
/usr/lib/gcr-(prompter|ssh-agent)		--	gen_context(system_u:object_r:bin_t)
/usr/lib/glib-pacrunner				--	gen_context(system_u:object_r:bin_t)
/usr/lib/gvfs[^/]*				--	gen_context(system_u:object_r:bin_t)
/usr/lib/kf6/kiod6				--	gen_context(system_u:object_r:bin_t)
/usr/lib/xdg-desktop-portal[^/]*		--	gen_context(system_u:object_r:bin_t)
/usr/lib/xdg-(document-portal|permission-store)	--	gen_context(system_u:object_r:bin_t)

# The login screen runs as the "greeter" user in staff_t; its home and cache are its
# own user data.
/var/lib/greeter(/.*)?				gen_context(system_u:object_r:user_home_t)
/var/cache/dms-greeter(/.*)?			gen_context(system_u:object_r:user_home_t)
/var/tmp/trivalent_cache(/.*)?			gen_context(system_u:object_r:chromium_xdg_cache_t)
HOME_DIR/\.local/share/pki(/.*)?			gen_context(system_u:object_r:chromium_xdg_config_t)

# Run by pam_exec in the login domains; glycin's image loaders, started through bwrap,
# return to the user domain as programs.
/usr/lib/tungsten/home-label			--	gen_context(system_u:object_r:bin_t)
/usr/lib/glycin-loaders(/.*)?				gen_context(system_u:object_r:bin_t)
