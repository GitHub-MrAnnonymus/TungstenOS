# Preloaded next to hardened_malloc: ignores RLIMIT_AS (address-space limits), which
# hardened_malloc's large virtual reservations cannot work under (e.g. glycin's image
# loader sandbox, used by GTK 4). Other resource limits still apply. Used by secureblue.

pkgname=no_rlimit_as
_commit=47c3e4d0da4c088c5a6d1864209ab1d26f19c86a
pkgver=0.1.3
pkgrel=1
pkgdesc='Preloadable library that disables setrlimit(RLIMIT_AS)'
arch=(x86_64)
url='https://github.com/HastD/no_rlimit_as'
license=(MIT)
depends=(glibc)
makedepends=(git meson)
source=("git+$url.git#commit=$_commit")
sha256sums=('SKIP')

build() {
  arch-meson no_rlimit_as build
  meson compile -C build
}

package() {
  meson install -C build --destdir "$pkgdir"
  install -Dm644 no_rlimit_as/LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
