# Built from source at a release tag; tags are SSH-signed, which makepkg cannot verify
# (validpgpkeys is PGP only): prepare() checks the signature against allowed_signers.

pkgname=visorbox
pkgver=0.2.0
_commit=c3532eb172d73e678413a38c3cdd7db1363b072a  # tag v0.2.0
pkgrel=1
pkgdesc='Isolated development environments in gVisor containers'
arch=(x86_64)
url='https://codeberg.org/HastD/visorbox'
license=(GPL-3.0-or-later)
depends=(podman gvisor git)
makedepends=(git go openssh)
source=("git+https://codeberg.org/HastD/visorbox.git#tag=v${pkgver}"
        allowed_signers)
sha256sums=('SKIP'
            'df6ac7823b5ae0ce276541365bbd0394524df2506fab6c83cb039d53af5b6ab1')

prepare() {
  cd visorbox
  git -c gpg.format=ssh -c gpg.ssh.allowedSignersFile="$srcdir/allowed_signers" \
    verify-tag "v$pkgver"
  [ "$(git rev-parse HEAD)" = "$_commit" ] ||
    { echo "v$pkgver is not $_commit" >&2; return 1; }
  # What meson's configure_file would substitute (meson also builds the man page, which
  # needs pandoc).
  sed -i "s/@VERSION@/$pkgver/" src/visorbox.go
}

build() {
  cd visorbox/src
  export CGO_ENABLED=0 GOTOOLCHAIN=local GOPATH="$srcdir/gopath"
  export GOFLAGS="-buildmode=pie -trimpath -mod=readonly -modcacherw"
  go build -o ../visorbox-bin .
}

package() {
  cd visorbox
  install -Dm755 visorbox-bin "$pkgdir/usr/bin/visorbox"
  install -Dm644 data/visorbox-bash-completion.sh "$pkgdir/usr/share/bash-completion/completions/visorbox"
  install -Dm644 data/visorbox-fish-completion.fish "$pkgdir/usr/share/fish/vendor_completions.d/visorbox.fish"
  install -Dm644 -t "$pkgdir/usr/share/licenses/$pkgname" LICENSES/*
}
