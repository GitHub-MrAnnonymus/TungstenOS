# Arch Linux's quickshell package plus a fix for a use-after-free that crashes it under
# hardened_malloc (https://github.com/quickshell-mirror/quickshell/issues/947).
# Drop this package once a release contains the fix.
# It uses Qt's private API, so it must be rebuilt for every Qt minor release:
# scripts/update/qt-rebuild.sh updates _qtver and pkgrel.

pkgname=quickshell
pkgver=0.3.2
pkgrel=1.1
_qtver=6.12
pkgdesc='Flexible toolkit for making desktop shells with QtQuick'
arch=(x86_64)
url="https://git.outfoxxed.me/$pkgname/$pkgname"
license=(LGPL-3.0-only)
depends=(cpptrace libcpptrace.so
         glibc
         hicolor-icon-theme
         jemalloc libjemalloc.so
         libdrm
         libgcc libgcc_s.so
         libglvnd libEGL.so libOpenGL.so
         libpipewire libpipewire-0.3.so
         libstdc++ libstdc++.so
         libxcb
         mesa
         pam libpam.so
         polkit
         "qt6-base>=$_qtver" "qt6-base<${_qtver%.*}.$(( ${_qtver#*.} + 1 ))"
         qt6-declarative
         qt6-svg
         qt6-wayland
         wayland libwayland-client.so)
makedepends=(cli11
             cmake
             ninja
             qt6-shadertools
             spirv-tools
             vulkan-headers
             wayland-protocols)
_archive="$pkgname-$pkgver"
source=("$_archive.tar.gz::$url/archive/v$pkgver.tar.gz"
        0001-hyprland-ipc-deleteLater-request-sockets.patch)
sha256sums=('f14115a73c9fff6aa6399f924b632e88c3ce2cead2657f814a7825341f35baad'
            '28c1c5654e719ed11d825edb48612a24adf3e38ae7b07b44c4aa9d497621d9f3')

prepare() {
	cd "$pkgname"
	patch -Np1 < ../0001-hyprland-ipc-deleteLater-request-sockets.patch
}

build() {
	cd "$pkgname"
	local cmake_options=(
		-D CMAKE_BUILD_TYPE=RelWithDebInfo
		-D DISTRIBUTOR='TungstenOS'
		-D DISTRIBUTOR_DEBUGINFO_AVAILABLE=No
		-D CRASH_REPORTER=Off
		-D CMAKE_INSTALL_PREFIX=/usr
		-D INSTALL_QML_PREFIX=lib/qt6/qml
	)
	cmake -G Ninja -B build -W no-dev "${cmake_options[@]}"
	cmake --build build
}

package() {
	cd "$pkgname"
	DESTDIR="$pkgdir" cmake --install build
	install -Dm0644 -t "$pkgdir/usr/share/licenses/$pkgname/" LICENSE
}
