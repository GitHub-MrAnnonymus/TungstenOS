pkgname=hardened_malloc
_commit=bf37d54560a62b50da72e8fda56abf04f23b5fd2
pkgver=r0.${_commit:0:7}
pkgrel=2
pkgdesc='Hardened memory allocator from GrapheneOS'
arch=(x86_64)
url='https://github.com/GrapheneOS/hardened_malloc'
license=(MIT)
depends=(glibc)
makedepends=(git)
source=("git+https://github.com/GrapheneOS/hardened_malloc.git#commit=${_commit}")
sha256sums=('SKIP')

build() {
  cd hardened_malloc
  # Upstream defaults to CONFIG_NATIVE=true (-march=native): optimized for the CI runner's
  # CPU. Preloaded into every process, it made everything die with "Illegal instruction" on
  # an older CPU (an image build on another runner; on users' machines just the same).
  make CONFIG_NATIVE=false
}

package() {
  cd hardened_malloc
  install -Dm755 out/libhardened_malloc.so "$pkgdir/usr/lib/libhardened_malloc.so"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
