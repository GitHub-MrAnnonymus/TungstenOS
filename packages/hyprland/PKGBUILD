# Arch Linux's hyprland package (its maintainers and contributors credited below), built
# here with two changes, until upstream has the first (aquamarine #423):
# - 0001-keep-max-bpc.patch: the first commit after a previous DRM master does not lower
#   "max bpc", which made i915 do a full modeset: the panel went dark for about a second
#   when the login screen and the session started.
# - -ftrivial-auto-var-init=zero: uninitialized stack variables are zeroed. The compositor
#   parses the Wayland requests of every app, sandboxed Flatpaks too.
# Only hyprland, not hyprpm: plugins are refused on TungstenOS. scripts/update/run.sh keeps
# pkgver and the checksum in step with Arch.
#
# Maintainer: Caleb Maclennan <caleb@alerque.com>
# Contributor: ThatOneCalculator <kainoa@t1c.dev>
# Contributor: Brenno Lemos <brenno@syndel.is>
# Contributor: Gabriel Fox <inbox@gabrielfox.dev>

pkgname=hyprland
pkgver=0.57.2
pkgrel=1.1
pkgdesc='a highly customizable dynamic tiling Wayland compositor'
arch=(x86_64)
url="https://github.com/hyprwm/Hyprland"
license=(BSD-3-Clause)
depends=(cairo # libcairo.so
         aquamarine
         libgcc # libgcc_s.so
         'libstdc++' # libstdc++.so
         glibc # libc.so libm.so
         glib2
         glslang # libglslang-default-resource-limits.so libglslang.so
         hyprcursor
         hyprgraphics
         hyprland-guiutils
         hyprlang
         hyprutils
         hyprwire
         lcms2
         libcanberra
         libdrm # libdrm.so
         libei
         libglvnd
         libinput # libinput.so
         libx11
         libxcb # libxcb-dri3.so libxcb-present.so libxcb-render.so libxcb-res.so libxcb-shm.so libxcb.so libxcb-xfixes.so libxcb-xinput.so
         libxcomposite # libxcb-composite.so
         libxcursor # libXcursor.so
         libxfixes
         libxkbcommon
         libxrender
         lua # liblua.so
         mesa # libgbm.so
         muparser # libmuparser.so
         opengl-driver
         pango
         pixman
         re2
         sdbus-cpp
         tomlplusplus
         util-linux-libs
         wayland
         wayland-protocols
         xcb-proto
         xcb-util
         xcb-util-errors # libxcb-errors.so
         xcb-util-image
         xcb-util-keysyms
         xcb-util-renderutil # libxcb-render-util.so
         xcb-util-wm # libxcb-ewmh.so  libxcb-icccm.so
         xorg-xwayland)
makedepends=(cmake
             glaze
             hyprland-protocols
             hyprwayland-scanner
             meson
             ninja
             xorgproto)
optdepends=('hyprshutdown: clean logout and shutdown helper'
            'xdg-desktop-portal-hyprland: xdg-desktop-portal backend for hyprland')
provides=(wayland-compositor)
_archive="Hyprland-$pkgver"
source=("$_archive.tar.gz::$url/releases/download/v$pkgver/source-v$pkgver.tar.gz"
        0001-keep-max-bpc.patch
        cfi-ignorelist.txt)
sha256sums=('34dbec0738ab88c8228caf89385662688ab1601ea58fbe5c60a6b6ab383db46d'
            '64288e7f269b541f1a8741a4929509501a7a20676246b24a160d5bf977a1cd0c'
            '1b228ef1b68bed9e5cfe176890cf0466165713a2ac056e75db87965f44cf361b')

# Clang CFI trial (.github/workflows/hyprland-cfi.yml), off in the normal build:
#   TUNGSTEN_CFI=diagnose  every failed check is printed (file:line, the types) and Hyprland
#                          keeps running: for finding what still needs an exemption or a fix
#   TUNGSTEN_CFI=trap      a failed check stops Hyprland: the hardened build, once a diagnose
#                          run reports nothing
# Built with clang and ThinLTO (CFI needs LTO; Hyprland turns LTO off only to keep plugins
# working, and plugins are refused here anyway).
if [ -n "${TUNGSTEN_CFI:-}" ]; then
	makedepends+=(clang lld llvm compiler-rt)
fi

prepare() {
	ln -sf hyprland-source "$_archive"
	cd "$_archive"
	sed -i -e '/^release:/{n;s/-D/-DCMAKE_SKIP_RPATH=ON -D/}' Makefile
	sed -i -e '/find_package.glaze/s/7...<8 //' {.,hyprpm,start}/CMakeLists.txt
	patch -Np1 -i "$srcdir/0001-keep-max-bpc.patch"
	if [ -n "${TUNGSTEN_CFI:-}" ]; then
		sed -i -e '/^add_compile_options(-fno-lto)$/d' CMakeLists.txt
	fi
}

build() {
	cd "$_archive"
	export CFLAGS="$CFLAGS -ftrivial-auto-var-init=zero"
	export CXXFLAGS="$CXXFLAGS -ftrivial-auto-var-init=zero"
	if [ -n "${TUNGSTEN_CFI:-}" ]; then
		local cfi="-flto=thin -fvisibility=hidden -fsanitize=cfi -fsanitize-ignorelist=$srcdir/cfi-ignorelist.txt"
		case $TUNGSTEN_CFI in
			diagnose) cfi+=" -fno-sanitize-trap=cfi -fsanitize-recover=cfi" ;;
			trap) ;;
			*) echo "TUNGSTEN_CFI must be diagnose or trap" >&2; return 1 ;;
		esac
		export CC=clang CXX=clang++
		export CFLAGS="${CFLAGS//-flto=auto/} $cfi"
		export CXXFLAGS="${CXXFLAGS//-flto=auto/} $cfi"
		export LDFLAGS="${LDFLAGS//-flto=auto/} -fuse-ld=lld $cfi"
	fi
	make release PREFIX=/usr
}

package() {
	depends+=(libEGL.so
	          libGLESv2.so
	          libaquamarine.so
	          libcanberra.so
	          libeis.so
	          libgio-2.0.so
	          libgobject-2.0.so
	          libhyprcursor.so
	          libhyprgraphics.so
	          libhyprlang.so
	          libhyprutils.so
	          libhyprwire.so
	          liblcms2.so
	          libpango-1.0.so
	          libpangocairo-1.0.so
	          libpixman-1.so
	          libre2.so
	          libreadline.so
	          libsdbus-c++.so
	          libtomlplusplus.so
	          libuuid.so
	          libwayland-server.so
	          libxkbcommon.so)
	cd "$_archive"
	make DESTDIR="$pkgdir" install
	rm -fv "$pkgdir/usr/include/hyprland/src/version.h.in"
	find $pkgdir -name '*hyprpm*' -delete
	install -Dm0644 -t "$pkgdir/usr/share/licenses/$pkgname/" LICENSE
}
