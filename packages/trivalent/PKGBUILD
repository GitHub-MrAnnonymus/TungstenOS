# Repackages secureblue's Trivalent RPM. Bump with ./update.py, which verifies
# the signed repository metadata and pins the RPM checksum.

pkgname=trivalent
pkgver=157.0.8103.78
_rpmrel=448613
pkgrel=1
pkgdesc='Hardened Chromium for desktop Linux by secureblue (repackaged RPM)'
arch=(x86_64)
url='https://github.com/secureblue/Trivalent'
license=('GPL-2.0-only' 'BSD-3-Clause' 'LGPL-2.1-or-later' 'Apache-2.0' 'MIT')
depends=(
  alsa-lib brotli bubblewrap dbus desktop-file-utils flac fontconfig freetype2
  gtk3 harfbuzz hicolor-icon-theme icu libcups libffi libgcrypt libjpeg-turbo
  libpng libpulse libva libwebp libxml2 libxslt libxss minizip nss opus
  pciutils systemd ttf-liberation xdg-utils
)
optdepends=('pipewire: WebRTC screen sharing under Wayland')
options=(!strip !debug)
source=("https://repo.secureblue.dev/Packages/trivalent-${pkgver}-${_rpmrel}.x86_64.rpm")
noextract=("trivalent-${pkgver}-${_rpmrel}.x86_64.rpm")
sha256sums=('cfa245beee7e1f4241696700e24916f6418607d515872ef677b977168eec5e67')

prepare() {
  rm -rf root && mkdir root
  bsdtar -xf "trivalent-${pkgver}-${_rpmrel}.x86_64.rpm" -C root
  mv root/usr/lib64 root/usr/lib
  # The GPU process loads Mesa's libgallium-<version>.so before its sandbox closes. The
  # version is cut from the file name after the last "-", which fits Fedora's
  # libgallium-26.2.6.so but gives "arch1.1" for Arch's libgallium-26.2.6-arch1.1.so: no
  # driver, the GPU process crashes, and Trivalent falls back to software rendering.
  sed -i 's|GALLIUMVER="${libgallium\[-1\]##\*-}"|GALLIUMVER="${libgallium[-1]##*/libgallium-}"|' \
    root/etc/trivalent/trivalent.conf
  grep -qF 'GALLIUMVER="${libgallium[-1]##*/libgallium-}"' root/etc/trivalent/trivalent.conf ||
    { echo "trivalent.conf: libgallium version patch did not apply" >&2; return 1; }
  rm -f root/usr/lib/tmpfiles.d/*-drm-fix-secontexts.conf root/usr/share/user-tmpfiles.d/*-drm-fix-secontexts.conf
}

package() {
  cp -a root/. "$pkgdir/"
  if find "$pkgdir" -perm -4000 | grep -q .; then
    echo "unexpected setuid file in Trivalent RPM" >&2
    return 1
  fi
}
