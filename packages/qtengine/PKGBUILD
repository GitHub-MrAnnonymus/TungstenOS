# qtengine, a Qt platform theme (KDE color schemes and icon themes for Qt apps), Qt 6 only.
# Based on the AUR package. It uses Qt's private API, so it must be rebuilt for every Qt
# minor release: scripts/update/qt-rebuild.sh updates _qtver and pkgrel.

pkgname=qtengine
pkgver=0.2.2
pkgrel=1
_qtver=6.12
pkgdesc='Qt platform theme made easy (Qt 6)'
arch=(x86_64)
url='https://github.com/kossLAN/qtengine'
license=(BSD-2-Clause)
depends=(kcolorscheme kconfig kconfigwidgets kiconthemes
         "qt6-base>=$_qtver" "qt6-base<${_qtver%.*}.$(( ${_qtver#*.} + 1 ))")
makedepends=(cmake ninja extra-cmake-modules)
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/$pkgver.tar.gz")
sha256sums=('8406285955ac735c8b208a73ad4d106535b32da47e25f050a5be18bbc9f0445e')

build() {
	cmake -S "$pkgname-$pkgver" -B build -G Ninja -W no-dev \
		-D CMAKE_BUILD_TYPE=Release -D CMAKE_INSTALL_PREFIX=/usr \
		-D BUILD_QT5=OFF -D BUILD_QT6=ON
	cmake --build build
}

package() {
	DESTDIR="$pkgdir" cmake --install build
	install -Dm0644 -t "$pkgdir/usr/share/licenses/$pkgname/" "$pkgname-$pkgver/LICENSE"
}
