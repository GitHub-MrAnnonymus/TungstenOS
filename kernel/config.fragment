# Merged over config.base (Arch linux-hardened); the build fails if any option is not honoured.

# --- LSMs ---
# CONFIG_SECURITY_APPARMOR is not set
CONFIG_SECURITY_SELINUX=y
CONFIG_SECURITY_SELINUX_BOOTPARAM=y
# Allows permissive mode; disable once the policy is complete.
CONFIG_SECURITY_SELINUX_DEVELOP=y
CONFIG_DEFAULT_SECURITY_SELINUX=y
CONFIG_LSM="landlock,lockdown,yama,integrity,selinux,bpf,ipe"
CONFIG_AUDIT=y
CONFIG_AUDITSYSCALL=y

# Unprivileged user namespaces are gated by SELinux, not disabled.
CONFIG_USER_NS=y
# CONFIG_OVERLAY_FS_UNPRIVILEGED is not set

# --- Integrity ---
CONFIG_SECURITY_IPE=y
CONFIG_IPE_PROP_DM_VERITY=y
CONFIG_EROFS_FS=y
CONFIG_EROFS_FS_XATTR=y
CONFIG_EROFS_FS_SECURITY=y
CONFIG_MODULE_SIG_FORCE=y
CONFIG_SECURITY_LOCKDOWN_LSM=y
CONFIG_SECURITY_LOCKDOWN_LSM_EARLY=y
CONFIG_LOCK_DOWN_KERNEL_FORCE_CONFIDENTIALITY=y

# --- Clang CFI ---
CONFIG_CFI=y
# CONFIG_CFI_PERMISSIVE is not set
CONFIG_FINEIBT=y
CONFIG_LTO_NONE=y

# --- Additional hardening ---
CONFIG_ZERO_CALL_USED_REGS=y
# CONFIG_HIBERNATION is not set
# CONFIG_KEXEC is not set
# CONFIG_KEXEC_FILE is not set


# --- From secureblue/kernel (copr_script.sh @ 47de460) ---
# EXPERT is required to disable X86_VSYSCALL_EMULATION and CACHESTAT_SYSCALL;
# it un-hides the TV-tuner sub-drivers below, which are disabled explicitly.
CONFIG_EXPERT=y
# CONFIG_VIDEO_CS5345 is not set
# CONFIG_VIDEO_CS53L32A is not set
# CONFIG_VIDEO_CX25840 is not set
# CONFIG_VIDEO_M52790 is not set
